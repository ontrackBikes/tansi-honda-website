<%- include("../partials/admin-header") %>

  <div class="container py-4 min-vh-100">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="fw-bold mb-1">Manage Models</h2>
        <p class="text-muted small">Add, edit, delete models</p>
      </div>
      <a href="/admin/add" class="btn btn-danger px-4 py-2 fw-bold shadow-sm rounded-3">
        <i class="bi bi-plus-lg me-2"></i>Add New Model
      </a>
    </div>

    <div class="row g-4 mb-5">
      <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 stats-card">
          <div class="d-flex align-items-center">
            <div class="stats-icon bg-light-red text-danger me-3">
              <i class="bi bi-box-seam fs-4"></i>
            </div>
            <div>
              <p class="text-muted small mb-0 fw-semibold">Total Models</p>
              <h3 class="fw-bold mb-0">
                <%= models.length %>
              </h3>
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 stats-card">
          <div class="d-flex align-items-center">
            <div class="stats-icon bg-light-success text-success me-3">
              <i class="bi bi-check-circle fs-4"></i>
            </div>
            <div>
              <p class="text-muted small mb-0 fw-semibold">Active Models</p>
              <h3 class="fw-bold mb-0">
                <%= models.filter(m=> m.isActive).length %>
              </h3>
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 stats-card">
          <div class="d-flex align-items-center">
            <div class="stats-icon bg-light-secondary text-secondary me-3">
              <i class="bi bi-pause-circle fs-4"></i>
            </div>
            <div>
              <p class="text-muted small mb-0 fw-semibold">Inactive</p>
              <h3 class="fw-bold mb-0">
                <%= models.filter(m=> !m.isActive).length %>
              </h3>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
      <div class="card-header bg-white border-0 p-4">
        <h5 class="fw-bold mb-0">All Models</h5>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="bg-light">
            <tr>
              <th class="ps-4 border-0 text-muted small text-uppercase py-3">Product</th>
              <th class="ps-4 border-0 text-muted small text-uppercase py-3">Price</th>
              <th class="border-0 text-muted small text-uppercase py-3 text-center">Status</th>
              <th class="pe-4 border-0 text-muted small text-uppercase py-3 text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (models.length===0) { %>
              <tr>
                <td colspan="4" class="text-center py-5 text-muted">No models found in database</td>
              </tr>
              <% } %>

                <% models.forEach(m=> { %>
                  <tr class="table-row">
                    <td class="ps-4 py-3">
                      <div class="d-flex align-items-center">
                        <img src="<%= m.coverImage || '/images/default-bike.jpg' %>" alt="Model image"
                          class="rounded-3 shadow-sm me-3" style="width: 60px; height: 45px; object-fit: cover;">
                        <span class="fw-bold text-dark">
                          <%= m.name %>
                        </span>
                      </div>
                    </td>

                    <td class="ps-4 py-3">
                      <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold text-dark">
                          ₹<%= m.variants?.[0]?.price?.exShowroom || 0 %>
                        </span>

                        <!-- 🔥 Price Edit Button -->
                        <a class="btn btn-sm btn-outline-primary border-0 me-1 action-btn"
                          onclick="openPriceModal('<%= m._id %>', `<%= m.name %>`, decodeURIComponent('<%= encodeURIComponent(JSON.stringify(m.variants)) %>'))">
                          <i class="bi bi-pencil"></i>
                        </a>
                      </div>
                    </td>

                    <td class="text-center">
                      <% if (m.isActive) { %>
                        <span class="badge rounded-pill bg-light-success text-success px-3">Active</span>
                        <% } else { %>
                          <span class="badge rounded-pill bg-light-secondary text-secondary px-3">Inactive</span>
                          <% } %>
                    </td>

                    <td class="pe-4 text-end">
                      <div class="d-flex align-items-center justify-content-end gap-3">

                        <form action="/admin/toggle-status/<%= m._id %>" method="POST" class="d-inline m-0">
                          <div class="form-check form-switch m-0 p-0 d-flex align-items-center">
                            <input class="form-check-input m-0 cursor-pointer" type="checkbox" role="switch"
                              id="switch-<%= m._id %>" <%=m.isActive ? 'checked' : '' %>
                            onchange="this.form.submit()"
                            style="width: 2.4em; height: 1.2em;">
                          </div>
                        </form>

                        <!-- <a href="/admin/edit/<%= m._id %>"
                          class="btn btn-sm btn-outline-warning border-0 p-1 action-btn shadow-none">
                          <i class="bi bi-pencil-square fs-5"></i>
                        </a> -->

                        <!-- <form action="/admin/delete/<%= m._id %>" method="POST" class="d-inline m-0"
                          onsubmit="return confirm('Delete this model?')">
                          <button class="btn btn-sm btn-outline-danger border-0 p-1 action-btn shadow-none">
                            <i class="bi bi-trash3 fs-5"></i>
                          </button>
                        </form> -->

                      </div>
                    </td>
                  </tr>
                  <% }) %>
          </tbody>
        </table>
      </div>
    </div>


    <!-- 🔥 Price Edit Modal -->
    <div class="modal fade" id="priceModal" tabindex="-1">
      <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4">
          <div class="modal-header bg-light">
            <h5 class="modal-title fw-bold">Update Detailed Pricing</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>

          <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
            <h4 id="bikeName" class="fw-bold text-danger mb-4"></h4>
            <div id="variantPriceList"></div>
          </div>

          <div class="modal-footer">
            <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button class="btn btn-danger px-4" onclick="updatePrice()">Save All Changes</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    body {
      background-color: #f8f9fa;
    }

    /* Stats Cards Custom Colors */
    .bg-light-red {
      background-color: rgba(230, 0, 18, 0.1);
    }

    .bg-light-success {
      background-color: rgba(25, 135, 84, 0.1);
    }

    .bg-light-secondary {
      background-color: rgba(108, 117, 125, 0.1);
    }

    .stats-icon {
      width: 50px;
      height: 50px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
    }

    .stats-card {
      transition: transform 0.2s;
    }

    .stats-card:hover {
      transform: translateY(-5px);
    }

    /* Table Customization */
    .table-row {
      transition: background-color 0.2s;
    }

    .table-row:hover {
      background-color: #fcfcfc;
    }

    .btn-danger {
      background-color: #e60012;
      border: none;
    }

    .btn-danger:hover {
      background-color: #c40010;
    }

    .action-btn {
      font-size: 1.1rem;
      padding: 5px 10px;
      border-radius: 8px;
    }

    .action-btn:hover {
      background-color: #f8f9fa;
    }

    .badge {
      font-weight: 600;
      font-size: 0.75rem;
      letter-spacing: 0.5px;
    }

    /* Makes the switch slightly larger and centers it vertically */
    .form-switch .form-check-input {
      cursor: pointer;
      width: 2.5em;
      height: 1.25em;
    }

    .form-check-input:checked {
      background-color: #198754;
      /* Success Green */
      border-color: #198754;
    }
  </style>

  <script>
    let selectedBikeId = null;
    let selectedVariants = [];

    function openPriceModal(bikeId, bikeName, variantsJson) {
      selectedBikeId = bikeId;
      // Handle potential double encoding or string issues
      selectedVariants = JSON.parse(variantsJson);

      document.getElementById("bikeName").innerText = bikeName;
      const container = document.getElementById("variantPriceList");
      container.innerHTML = "";

      selectedVariants.forEach((v, index) => {
        const p = v.price || {};
        container.innerHTML += `
        <div class="variant-card mb-4 p-3 border rounded-3 bg-white shadow-sm" data-variant-id="${v._id}">
          <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">${v.name}</h5>
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label small fw-bold">Ex-Showroom</label>
              <input type="number" class="form-control price-input" data-field="exShowroom" value="${p.exShowroom || 0}">
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-bold">Road Tax & Reg</label>
              <input type="number" class="form-control price-input" data-field="roadTaxAndReg" value="${p.roadTaxAndReg || 0}">
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-bold">Insurance (Base)</label>
              <input type="number" class="form-control price-input" data-field="insuranceBase" value="${p.insuranceBase || 0}">
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-bold">On-Road Base</label>
              <input type="number" class="form-control price-input" data-field="onRoadBase" value="${p.onRoadBase || 0}">
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-bold">Zero Dep Premium</label>
              <input type="number" class="form-control price-input" data-field="zeroDepPremium" value="${p.zeroDepPremium || 0}">
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-bold">Final On-Road</label>
              <input type="number" class="form-control price-input" data-field="finalOnRoad" value="${p.finalOnRoad || 0}">
            </div>
          </div>
        </div>
      `;
      });

      const modal = new bootstrap.Modal(document.getElementById("priceModal"));
      modal.show();
    }

    async function updatePrice() {
      const variantCards = document.querySelectorAll(".variant-card");

      try {
        // Loop through each variant section in the modal
        for (let card of variantCards) {
          const variantId = card.getAttribute("data-variant-id");
          const inputs = card.querySelectorAll(".price-input");

          // Build the price object based on your schema
          const priceData = {};
          inputs.forEach(input => {
            priceData[input.getAttribute("data-field")] = Number(input.value);
          });

          // Send update to server
          await fetch(`/admin/update-price/${selectedBikeId}/${variantId}`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(priceData), // Sending the whole object
          });
        }

        alert("All variants updated successfully ✅");
        location.reload();
      } catch (err) {
        console.error(err);
        alert("Error updating prices ❌");
      }
    }
  </script>

  <%- include("../partials/footer") %>