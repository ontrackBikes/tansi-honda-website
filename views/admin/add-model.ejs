<%- include("../partials/header") %>

<h2 class="mb-4">Add New Model</h2>
<a href="/admin" class="btn btn-link mb-3">← Back</a>

<form action="/admin/add" method="POST">

<div class="row">

<!-- LEFT -->
<div class="col-md-6">

<div class="mb-3">
<label>Model Name</label>
<input name="name" class="form-control" required>
</div>

<div class="mb-3">
<label>Category</label>
<select name="category" id="category" class="form-select">
<option value="Motorcycle">Motorcycle</option>
<option value="Scooter">Scooter</option>
<option value="EV">EV</option>
</select>
</div>

<div class="mb-3" id="subCategoryBox">
<label>Sub Category</label>
<select name="subCategory" class="form-select">
<option value="RedWing">RedWing</option>
<option value="BigWing">BigWing</option>
</select>
</div>

<div class="mb-3">
<label>Description</label>
<textarea name="description" class="form-control"></textarea>
</div>

<div class="mb-3">
<label>Brochure URL</label>
<input name="brochure" class="form-control">
</div>

<!-- 🎨 COLORS -->
<h5>Colors</h5>
<div class="mb-3">
<input name="color_name" class="form-control mb-1" placeholder="Color Name">
<input name="color_code" class="form-control mb-1" placeholder="#000000">
<input name="color_image" class="form-control" placeholder="/images/...">
</div>

</div>

<!-- RIGHT -->
<div class="col-md-6">

<div class="mb-3">
<label>Upload Default Image</label>
<input type="file" id="imageInput" class="form-control">
</div>

<input type="hidden" name="coverImage" id="imageUrl">

<img id="previewImage" class="img-fluid rounded mt-2"
src="/images/default-bike.jpg">

<p id="uploadStatus"></p>

</div>

</div>

<hr>

<!-- 🔥 VARIANT -->
<h4>Variant</h4>

<div class="mb-3">
<input name="variant_name" class="form-control mb-2" placeholder="Variant Name (Standard)">
<input name="sku" class="form-control" placeholder="SKU">
</div>

<!-- 🔧 BODY -->
<h5>Body Dimensions</h5>
<div class="row">
<input name="length" class="form-control col m-1" placeholder="Length">
<input name="width" class="form-control col m-1" placeholder="Width">
<input name="height" class="form-control col m-1" placeholder="Height">
<input name="wheelbase" class="form-control col m-1" placeholder="Wheelbase">
<input name="ground_clearance" class="form-control col m-1" placeholder="Ground Clearance">
<input name="kerb_weight" class="form-control col m-1" placeholder="Kerb Weight">
<input name="seat_height" class="form-control col m-1" placeholder="Seat Height">
<input name="fuel_tank" class="form-control col m-1" placeholder="Fuel Tank">
</div>

<!-- ⚙️ ENGINE -->
<h5 class="mt-3">Engine</h5>
<div class="row">
<input name="engine_type" class="form-control col m-1" placeholder="Type">
<input name="displacement" class="form-control col m-1" placeholder="Displacement">
<input name="power" class="form-control col m-1" placeholder="Power">
<input name="torque" class="form-control col m-1" placeholder="Torque">
<input name="fuel_system" class="form-control col m-1" placeholder="Fuel System">
<input name="bore_stroke" class="form-control col m-1" placeholder="Bore x Stroke">
<input name="compression_ratio" class="form-control col m-1" placeholder="Compression Ratio">
<input name="starting" class="form-control col m-1" placeholder="Starting">
</div>

<!-- ⚙️ TRANSMISSION -->
<h5 class="mt-3">Transmission</h5>
<input name="clutch" class="form-control mb-2" placeholder="Clutch">
<input name="gears" class="form-control" placeholder="Gears">

<!-- 🛞 TYRES -->
<h5 class="mt-3">Tyres & Brakes</h5>
<input name="front_tyre" class="form-control mb-2" placeholder="Front Tyre">
<input name="rear_tyre" class="form-control mb-2" placeholder="Rear Tyre">
<input name="front_brake" class="form-control mb-2" placeholder="Front Brake">
<input name="rear_brake" class="form-control" placeholder="Rear Brake">

<!-- 🏍️ SUSPENSION -->
<h5 class="mt-3">Suspension</h5>
<input name="frame" class="form-control mb-2" placeholder="Frame">
<input name="front_suspension" class="form-control mb-2" placeholder="Front Suspension">
<input name="rear_suspension" class="form-control" placeholder="Rear Suspension">

<!-- 🔋 ELECTRICAL -->
<h5 class="mt-3">Electricals</h5>
<input name="battery" class="form-control mb-2" placeholder="Battery">
<input name="headlamp" class="form-control" placeholder="Headlamp">

<button class="btn btn-primary mt-4">Add Model</button>

</form>

<script>
// hide subcategory if not motorcycle
const category = document.getElementById("category");
const subBox = document.getElementById("subCategoryBox");

category.addEventListener("change", () => {
  subBox.style.display = category.value === "Motorcycle" ? "block" : "none";
});

// upload
const input = document.getElementById("imageInput");
const preview = document.getElementById("previewImage");
const hidden = document.getElementById("imageUrl");

input.addEventListener("change", async () => {
  const file = input.files[0];
  const formData = new FormData();
  formData.append("image", file);

  const res = await fetch("/admin/upload-image", { method: "POST", body: formData });
  const data = await res.json();

  if (data.url) {
    hidden.value = data.url;
    preview.src = data.url;
  }
});
</script>

<%- include("../partials/footer") %>