<%- include("../partials/header") %>

<h2 class="mb-4">Add New Model</h2>

<a href="/admin" class="btn btn-link mb-3">← Back to Dashboard</a>

<form action="/admin/add" method="POST">

  <div class="row">

    <!-- LEFT -->
    <div class="col-md-6">

      <div class="mb-3">
        <label class="form-label">Model Name</label>
        <input type="text" name="name" class="form-control" required />
      </div>

      <div class="mb-3">
        <label class="form-label">Category</label>
        <select name="category" class="form-select">
          <option value="Bike">Bike</option>
          <option value="Scooter">Scooter</option>
          <option value="Touring">Touring</option>
        </select>
      </div>

      <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea name="description" rows="3" class="form-control"></textarea>
      </div>

      <div class="mb-3">
        <label class="form-label">Features</label>
        <input type="text" name="features" class="form-control"
          placeholder="ABS, LED, Digital Meter" />
      </div>

      <!-- 🔧 SPECS -->
      <h5 class="mt-4">Specifications</h5>

      <div class="row">
        <div class="col-6 mb-2">
          <input name="engine" class="form-control" placeholder="Engine (e.g. 124cc)">
        </div>
        <div class="col-6 mb-2">
          <input name="mileage" class="form-control" placeholder="Mileage">
        </div>
        <div class="col-6 mb-2">
          <input name="power" class="form-control" placeholder="Power">
        </div>
        <div class="col-6 mb-2">
          <input name="torque" class="form-control" placeholder="Torque">
        </div>
        <div class="col-6 mb-2">
          <input name="fuel_type" class="form-control" placeholder="Fuel Type">
        </div>
        <div class="col-6 mb-2">
          <input name="transmission" class="form-control" placeholder="Transmission">
        </div>
      </div>

    </div>

    <!-- RIGHT -->
    <div class="col-md-6">

      <div class="mb-3">
        <label class="form-label">Upload Image</label>
        <input type="file" id="imageInput" class="form-control" />
      </div>

      <input type="hidden" name="image" id="imageUrl" />

      <div class="text-center mt-3">
        <img id="previewImage"
          src="/images/default-bike.jpg"
          class="img-fluid rounded shadow-sm"
          style="max-height: 250px;">
      </div>

      <p id="uploadStatus" class="text-success mt-2"></p>

    </div>

  </div>

  <button class="btn btn-primary mt-3">Add Model</button>

</form>

<script>
  const imageInput = document.getElementById("imageInput");
  const preview = document.getElementById("previewImage");
  const imageUrlInput = document.getElementById("imageUrl");
  const statusText = document.getElementById("uploadStatus");

  imageInput.addEventListener("change", async () => {
    const file = imageInput.files[0];
    if (!file) return;

    preview.src = URL.createObjectURL(file);
    statusText.innerText = "Uploading...";

    const formData = new FormData();
    formData.append("image", file);

    const res = await fetch("/admin/upload-image", {
      method: "POST",
      body: formData
    });

    const data = await res.json();

    if (data.url) {
      imageUrlInput.value = data.url;
      preview.src = data.url;
      statusText.innerText = "✅ Uploaded";
    } else {
      statusText.innerText = "❌ Failed";
    }
  });
</script>

<%- include("../partials/footer") %>