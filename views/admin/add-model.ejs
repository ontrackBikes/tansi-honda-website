<%- include("../partials/admin-header") %>

<div class="container py-4 min-vh-100">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <h2 class="fw-bold mb-0 text-dark">Add New Model</h2>
      <p class="text-muted small">
        Enter full technical specifications and media
      </p>
    </div>
    <a href="/admin/models" class="btn btn-outline-secondary btn-sm rounded-3 px-3">
      ← Back to Models
    </a>
  </div>

  <div id="formAlert" class="alert alert-danger rounded-3" hidden></div>

  <form id="modelForm" action="/admin/add" method="POST">
    <div class="row g-4">
      <div class="col-md-7">
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
          <h5 class="fw-bold mb-4 border-start border-danger border-4 ps-2 text-uppercase small">
            Basic Information
          </h5>

          <div class="mb-3">
            <label class="form-label small fw-bold text-muted">Model Name</label>
            <input type="text" id="modelName" class="form-control custom-input" placeholder="e.g. Honda Shine 100" required>
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label small fw-bold text-muted">Category</label>
              <select id="category" class="form-select custom-input">
                <option value="motorcycle">Motorcycle</option>
                <option value="scooter">Scooter</option>
                <option value="e2w">Electric (E2W)</option>
              </select>
            </div>
            <div class="col-md-6 mb-3" id="subCategoryBox">
              <label class="form-label small fw-bold text-muted">Sub Category</label>
              <select class="form-select custom-input">
                <option value="">— None —</option>
                <option value="RedWing">RedWing</option>
                <option value="BigWing">BigWing</option>
              </select>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold text-muted">Description</label>
            <textarea id="description" rows="3" class="form-control custom-input" placeholder="Marketing description..."></textarea>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold text-muted">Brochure URL (PDF)</label>
            <input type="url" id="brochure" class="form-control custom-input" placeholder="https://...">
          </div>

          <div class="p-3 rounded-3 bg-light border d-flex flex-wrap gap-4">
            <div class="form-check form-switch mb-0">
              <input class="form-check-input" type="checkbox" id="statusSwitch" checked>
              <label class="form-check-label fw-bold small text-uppercase ms-2" for="statusSwitch">Active</label>
            </div>
            <div class="form-check form-switch mb-0">
              <input class="form-check-input" type="checkbox" id="bookingsOpenSwitch">
              <label class="form-check-label fw-bold small text-uppercase ms-2" for="bookingsOpenSwitch">Bookings Open</label>
            </div>
          </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
          <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="fw-bold mb-0 border-start border-danger border-4 ps-2 text-uppercase small">
              Color Variants
            </h5>
            <button type="button" id="addColorBtn" class="btn btn-outline-danger btn-sm">
              <i class="bi bi-plus-lg"></i> Add Color
            </button>
          </div>
          <div id="colorsList"></div>
          <div class="form-text small">At least one color (with an image) is required — the model page shows it as the default photo.</div>
        </div>
      </div>

      <div class="col-md-5">
        <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 20px">
          <h5 class="fw-bold mb-4 border-start border-danger border-4 ps-2 text-uppercase small">
            Default Cover Image
          </h5>

          <div class="upload-zone text-center p-3 border border-2 border-dashed rounded-4 mb-3 bg-light">
            <img id="previewImage" src="/images/default-bike.jpg" class="img-fluid rounded-3 mb-3 shadow-sm"
              style="max-height: 200px; width: 100%; object-fit: cover">
            <input type="file" id="imageInput" class="form-control custom-input">
            <input type="hidden" id="imageUrl">
            <p id="uploadStatus" class="small mt-2 mb-0 fw-bold"></p>
          </div>

          <div class="alert alert-info py-2 px-3 rounded-3 border-0">
            <small>⚠️ Ensure the cover image has a transparent or clean background for the best dashboard look.</small>
          </div>
        </div>
      </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 mt-4">
      <h4 class="fw-bold mb-4 text-center">Advanced Features</h4>
      <div class="accordion" id="featuresAccordion">
        <% [["safety","Safety"],["comfort","Comfort"],["design","Design"],["technology","Technology"]].forEach(([key, label], i) => { %>
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#featurePanel-<%= key %>">
                <%= label %>
              </button>
            </h2>
            <div id="featurePanel-<%= key %>" class="accordion-collapse collapse">
              <div class="accordion-body">
                <div class="form-check form-switch mb-3">
                  <input class="form-check-input" type="checkbox" id="feature-show-<%= key %>">
                  <label class="form-check-label small fw-bold" for="feature-show-<%= key %>">Show this section on the model page</label>
                </div>
                <div id="feature-items-<%= key %>"></div>
                <button type="button" id="add-feature-item-<%= key %>" class="btn btn-outline-secondary btn-sm">
                  <i class="bi bi-plus-lg"></i> Add <%= label %> Highlight
                </button>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 mt-4">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <h4 class="fw-bold mb-0">Variants & Technical Specifications</h4>
        <button type="button" id="addVariantBtn" class="btn btn-danger btn-sm rounded-3">
          <i class="bi bi-plus-lg"></i> Add Variant
        </button>
      </div>
      <div id="variantsList"></div>
      <div class="form-text small">At least one variant with an Ex-Showroom price is required.</div>

      <div class="text-center mt-4">
        <button type="submit" class="btn btn-danger btn-lg px-5 py-3 fw-bold rounded-pill shadow">
          🚀 PUBLISH NEW MODEL
        </button>
      </div>
    </div>
  </form>
</div>

<style>
  body {
    background-color: #f8f9fa;
  }
  .custom-input {
    border-radius: 10px;
    padding: 10px 15px;
    border: 1px solid #dee2e6;
  }
  .custom-input:focus {
    border-color: #e60012;
    box-shadow: 0 0 0 3px rgba(230, 0, 18, 0.1);
  }
  .border-dashed {
    border-style: dashed !important;
    border-color: #ced4da !important;
  }
  .form-control-sm {
    border-radius: 6px;
  }
  .extra-small {
    font-size: 0.65rem;
    text-transform: uppercase;
    font-weight: 800;
    color: #adb5bd;
    display: block;
    margin-bottom: 2px;
  }
  .btn-danger {
    background-color: #e60012;
    border: none;
  }
  .btn-danger:hover {
    background-color: #c40010;
  }
  .accordion-button:not(.collapsed) {
    background-color: #fff5f5;
    color: #e60012;
  }
  .form-check-input:checked {
    background-color: #198754;
    border-color: #198754;
  }
</style>

<script>
  window.ADMIN_MODEL_FORM = { mode: "add", initialData: {} };
</script>
<script src="/js/admin-model-form.js"></script>

<%- include("../partials/footer") %>
