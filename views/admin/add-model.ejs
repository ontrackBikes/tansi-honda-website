<%- include("../partials/header") %>

<div class="container py-4">
  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <h2 class="fw-bold mb-0 text-dark">Add New Model</h2>
      <p class="text-muted small">
        Enter full technical specifications and media
      </p>
    </div>
    <a href="/admin" class="btn btn-outline-secondary btn-sm rounded-3 px-3">
      Back to Dashboard
    </a>
  </div>

  <form action="/admin/add" method="POST">
    <div class="row g-4">
      <div class="col-md-7">
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
          <h5
            class="fw-bold mb-4 border-start border-danger border-4 ps-2 text-uppercase small"
          >
            Basic Information
          </h5>

          <div class="mb-3">
            <label class="form-label small fw-bold text-muted"
              >Model Name</label
            >
            <input
              type="text"
              name="name"
              class="form-control custom-input"
              placeholder="e.g. Honda Shine 100"
              required
            />
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label small fw-bold text-muted"
                >Category</label
              >
              <select
                name="category"
                id="category"
                class="form-select custom-input"
              >
                <option value="Motorcycle">Motorcycle</option>
                <option value="Scooter">Scooter</option>
                <option value="EV">EV</option>
              </select>
            </div>
            <div class="col-md-6 mb-3" id="subCategoryBox">
              <label class="form-label small fw-bold text-muted"
                >Sub Category</label
              >
              <select name="subCategory" class="form-select custom-input">
                <option value="RedWing">RedWing</option>
                <option value="BigWing">BigWing</option>
              </select>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-bold text-muted"
              >Description</label
            >
            <textarea
              name="description"
              rows="3"
              class="form-control custom-input"
              placeholder="Marketing description..."
            ></textarea>
          </div>

          <div class="mb-0">
            <label class="form-label small fw-bold text-muted"
              >Brochure URL (PDF)</label
            >
            <input
              type="url"
              name="brochure"
              class="form-control custom-input"
              placeholder="https://..."
            />
          </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
          <h5
            class="fw-bold mb-4 border-start border-danger border-4 ps-2 text-uppercase small"
          >
            Color Variants
          </h5>
          <div class="p-3 rounded-3 bg-light border">
            <div class="row g-2">
              <div class="col-md-4">
                <input
                  name="color_name"
                  class="form-control form-control-sm"
                  placeholder="Name (e.g. Red)"
                />
              </div>
              <div class="col-md-3">
                <input
                  name="color_code"
                  class="form-control form-control-sm"
                  placeholder="#HEX Code"
                />
              </div>
              <div class="col-md-5">
                <input
                  name="color_image"
                  class="form-control form-control-sm"
                  placeholder="Image Path / URL"
                />
              </div>
            </div>
            <div class="form-text mt-2 small">
              Note: Currently adding 1 primary color variant.
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-5">
        <div
          class="card border-0 shadow-sm rounded-4 p-4 sticky-top"
          style="top: 20px"
        >
          <h5
            class="fw-bold mb-4 border-start border-danger border-4 ps-2 text-uppercase small"
          >
            Default Cover Image
          </h5>

          <div
            class="upload-zone text-center p-3 border border-2 border-dashed rounded-4 mb-3 bg-light"
          >
            <img
              id="previewImage"
              src="/images/default-bike.jpg"
              class="img-fluid rounded-3 mb-3 shadow-sm"
              style="max-height: 200px; width: 100%; object-fit: cover"
            />
            <input
              type="file"
              id="imageInput"
              class="form-control custom-input"
            />
            <input type="hidden" name="coverImage" id="imageUrl" />
            <p id="uploadStatus" class="small mt-2 mb-0 fw-bold"></p>
          </div>

          <div class="alert alert-info py-2 px-3 rounded-3 border-0">
            <small
              >⚠️ Ensure the cover image has a transparent or clean background
              for the best dashboard look.</small
            >
          </div>
        </div>
      </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 mt-4">
      <h4 class="fw-bold mb-4 text-center">Technical Specifications</h4>

      <div class="row mb-4 justify-content-center">
        <div class="col-md-4">
          <label class="small fw-bold text-muted">Variant Name</label>
          <input
            name="variant_name"
            class="form-control custom-input text-center fw-bold"
            placeholder="e.g. Standard"
          />
        </div>
        <div class="col-md-4">
          <label class="small fw-bold text-muted">SKU Code</label>
          <input
            name="sku"
            class="form-control custom-input text-center"
            placeholder="e.g. SH100-STD"
          />
        </div>
      </div>

      <div class="row g-4">
        <div class="col-md-6">
          <div class="p-3 rounded-4 border bg-white h-100">
            <h6 class="fw-bold mb-3">
              <i class="bi bi-box-fill"></i> Body Dimensions
            </h6>
            <div class="row g-2">
              <div class="col-4">
                <input
                  name="length"
                  class="form-control form-control-sm"
                  placeholder="Length"
                />
              </div>
              <div class="col-4">
                <input
                  name="width"
                  class="form-control form-control-sm"
                  placeholder="Width"
                />
              </div>
              <div class="col-4">
                <input
                  name="height"
                  class="form-control form-control-sm"
                  placeholder="Height"
                />
              </div>
              <div class="col-6">
                <input
                  name="wheelbase"
                  class="form-control form-control-sm"
                  placeholder="Wheelbase"
                />
              </div>
              <div class="col-6">
                <input
                  name="ground_clearance"
                  class="form-control form-control-sm"
                  placeholder="Ground Clearance"
                />
              </div>
              <div class="col-6">
                <input
                  name="kerb_weight"
                  class="form-control form-control-sm"
                  placeholder="Kerb Weight"
                />
              </div>
              <div class="col-6">
                <input
                  name="seat_height"
                  class="form-control form-control-sm"
                  placeholder="Seat Height"
                />
              </div>
              <div class="col-12">
                <input
                  name="fuel_tank"
                  class="form-control form-control-sm"
                  placeholder="Fuel Tank Capacity"
                />
              </div>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="p-3 rounded-4 border bg-white h-100">
            <h6 class="fw-bold mb-3">
              <i class="bi bi-gear-wide-connected"></i> Engine Details
            </h6>
            <div class="row g-2">
              <div class="col-12">
                <input
                  name="engine_type"
                  class="form-control form-control-sm"
                  placeholder="Engine Type (e.g. Air Cooled, 4 Stroke)"
                />
              </div>
              <div class="col-6">
                <input
                  name="displacement"
                  class="form-control form-control-sm"
                  placeholder="Displacement (cc)"
                />
              </div>
              <div class="col-6">
                <input
                  name="starting"
                  class="form-control form-control-sm"
                  placeholder="Starting (Kick/Self)"
                />
              </div>
              <div class="col-6">
                <input
                  name="power"
                  class="form-control form-control-sm"
                  placeholder="Max Power"
                />
              </div>
              <div class="col-6">
                <input
                  name="torque"
                  class="form-control form-control-sm"
                  placeholder="Max Torque"
                />
              </div>
              <div class="col-6">
                <input
                  name="fuel_system"
                  class="form-control form-control-sm"
                  placeholder="Fuel System"
                />
              </div>
              <div class="col-6">
                <input
                  name="compression_ratio"
                  class="form-control form-control-sm"
                  placeholder="Compression Ratio"
                />
              </div>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="p-3 rounded-4 border bg-white h-100">
            <h6 class="fw-bold mb-3">🛞 Tyres, Brakes & Suspension</h6>
            <div class="row g-2">
              <div class="col-6">
                <input
                  name="front_tyre"
                  class="form-control form-control-sm"
                  placeholder="Front Tyre"
                />
              </div>
              <div class="col-6">
                <input
                  name="rear_tyre"
                  class="form-control form-control-sm"
                  placeholder="Rear Tyre"
                />
              </div>
              <div class="col-6">
                <input
                  name="front_brake"
                  class="form-control form-control-sm"
                  placeholder="Front Brake"
                />
              </div>
              <div class="col-6">
                <input
                  name="rear_brake"
                  class="form-control form-control-sm"
                  placeholder="Rear Brake"
                />
              </div>
              <div class="col-12">
                <input
                  name="frame"
                  class="form-control form-control-sm"
                  placeholder="Frame Type"
                />
              </div>
              <div class="col-6">
                <input
                  name="front_suspension"
                  class="form-control form-control-sm"
                  placeholder="Front Suspension"
                />
              </div>
              <div class="col-6">
                <input
                  name="rear_suspension"
                  class="form-control form-control-sm"
                  placeholder="Rear Suspension"
                />
              </div>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="p-3 rounded-4 border bg-white h-100">
            <h6 class="fw-bold mb-3">🔋 Transmission & Electrical</h6>
            <div class="row g-2">
              <div class="col-6">
                <input
                  name="clutch"
                  class="form-control form-control-sm"
                  placeholder="Clutch Type"
                />
              </div>
              <div class="col-6">
                <input
                  name="gears"
                  class="form-control form-control-sm"
                  placeholder="No. of Gears"
                />
              </div>
              <div class="col-12">
                <input
                  name="battery"
                  class="form-control form-control-sm"
                  placeholder="Battery Specification"
                />
              </div>
              <div class="col-12">
                <input
                  name="headlamp"
                  class="form-control form-control-sm"
                  placeholder="Headlamp Type (LED/Halogen)"
                />
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="text-center mt-5">
        <button
          type="submit"
          class="btn btn-danger btn-lg px-5 py-3 fw-bold rounded-pill shadow"
        >
          🚀 PUBLISH NEW MODEL
        </button>
      </div>
    </div>
  </form>
</div>

<style>
  body {
    background-color: #f8f9fa;
    
  }
  .custom-input {
    border-radius: 10px;
    padding: 10px 15px;
    border: 1px solid #dee2e6;
  }
  .custom-input:focus {
    border-color: #e60012;
    box-shadow: 0 0 0 3px rgba(230, 0, 18, 0.1);
  }
  .border-dashed {
    border-style: dashed !important;
    border-color: #ced4da !important;
  }
  .form-control-sm {
    border-radius: 6px;
  }
  .btn-danger {
    background-color: #e60012;
    border: none;
  }
  .btn-danger:hover {
    background-color: #c40010;
    transform: scale(1.02);
  }
</style>

<script>
  // Category logic
  const category = document.getElementById("category");
  const subBox = document.getElementById("subCategoryBox");
  category.addEventListener("change", () => {
    subBox.style.opacity = category.value === "Motorcycle" ? "1" : "0.3";
    subBox.style.pointerEvents =
      category.value === "Motorcycle" ? "auto" : "none";
  });

  // Image Upload
  const input = document.getElementById("imageInput");
  const preview = document.getElementById("previewImage");
  const hidden = document.getElementById("imageUrl");
  const status = document.getElementById("uploadStatus");

  input.addEventListener("change", async () => {
    const file = input.files[0];
    if (!file) return;

    status.innerText = "⏳ Uploading...";
    status.className = "small mt-2 text-warning fw-bold";

    const formData = new FormData();
    formData.append("image", file);

    try {
      const res = await fetch("/admin/upload-image", {
        method: "POST",
        body: formData,
      });
      const data = await res.json();

      if (data.url) {
        hidden.value = data.url;
        preview.src = data.url;
        status.innerText = "✅ Upload Success";
        status.className = "small mt-2 text-success fw-bold";
      }
    } catch (e) {
      status.innerText = "❌ Upload Failed";
      status.className = "small mt-2 text-danger fw-bold";
    }
  });
</script>

<%- include("../partials/footer") %>
