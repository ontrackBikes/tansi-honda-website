<%- include("../partials/admin-header") %>

    <div class="container py-4 min-vh-100">

        <div class="position-fixed top-0 end-0 p-3" style="z-index:1080">
            <% if (toast==='updated' ) { %>
                <div id="liveToast" class="toast align-items-center text-bg-success border-0">
                    <div class="d-flex">
                        <div class="toast-body">
                            <i class="bi bi-check-circle-fill me-2"></i> Service status updated successfully
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto"
                            data-bs-dismiss="toast"></button>
                    </div>
                </div>
            <% } %>
        </div>

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1">Service Requests</h2>
                <p class="text-muted small">Manage customer service bookings</p>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="row g-4 mb-5">
            <div class="col-6 col-sm-6 col-md-2">
                <a href="/admin/services" class="text-decoration-none">
                    <div class="card border-0 shadow-sm rounded-4 p-3 stats-card <%= !currentStatus ? 'border-active-primary' : '' %>">
                        <div class="d-flex align-items-center">
                            <div class="stats-icon bg-light-primary text-primary me-3">
                                <i class="bi bi-tools fs-5"></i>
                            </div>
                            <div>
                                <p class="text-muted extra-small mb-0 fw-semibold">Total</p>
                                <h4 class="fw-bold mb-0">
                                    <%= stats.total %>
                                </h4>
                            </div>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-6 col-sm-6 col-md-2">
                <a href="/admin/services?status=pending" class="text-decoration-none">
                    <div class="card border-0 shadow-sm rounded-4 p-3 stats-card <%= currentStatus === 'pending' ? 'border-active-warning' : '' %>">
                        <div class="d-flex align-items-center">
                            <div class="stats-icon bg-light-warning text-warning me-3">
                                <i class="bi bi-hourglass-split fs-5"></i>
                            </div>
                            <div>
                                <p class="text-muted extra-small mb-0 fw-semibold">Pending</p>
                                <h4 class="fw-bold mb-0">
                                    <%= stats.pending %>
                                </h4>
                            </div>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-6 col-sm-6 col-md-2">
                <a href="/admin/services?status=confirmed" class="text-decoration-none">
                    <div class="card border-0 shadow-sm rounded-4 p-3 stats-card <%= currentStatus === 'confirmed' ? 'border-active-info' : '' %>">
                        <div class="d-flex align-items-center">
                            <div class="stats-icon bg-light-info text-info me-3">
                                <i class="bi bi-check2-square fs-5"></i>
                            </div>
                            <div>
                                <p class="text-muted extra-small mb-0 fw-semibold">Confirmed</p>
                                <h4 class="fw-bold mb-0">
                                    <%= stats.confirmed %>
                                </h4>
                            </div>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-6 col-sm-6 col-md-2">
                <a href="/admin/services?status=completed" class="text-decoration-none">
                    <div class="card border-0 shadow-sm rounded-4 p-3 stats-card <%= currentStatus === 'completed' ? 'border-active-success' : '' %>">
                        <div class="d-flex align-items-center">
                            <div class="stats-icon bg-light-success text-success me-3">
                                <i class="bi bi-check-circle fs-5"></i>
                            </div>
                            <div>
                                <p class="text-muted extra-small mb-0 fw-semibold">Completed</p>
                                <h4 class="fw-bold mb-0">
                                    <%= stats.completed %>
                                </h4>
                            </div>
                        </div>
                    </div>
                </a>
            </div>

             <div class="col-6 col-sm-6 col-md-2">
                <a href="/admin/services?status=follow-up" class="text-decoration-none">
                    <div class="card border-0 shadow-sm rounded-4 p-3 stats-card <%= currentStatus === 'follow-up' ? 'border-active-secondary' : '' %>">
                        <div class="d-flex align-items-center">
                            <div class="stats-icon bg-light-secondary text-secondary me-3">
                                <i class="bi bi-clock-history fs-5"></i>
                            </div>
                            <div>
                                <p class="text-muted extra-small mb-0 fw-semibold">Follow Up</p>
                                <h4 class="fw-bold mb-0">
                                    <%= stats.followUp %>
                                </h4>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        </div>

        <!-- Table Card -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-white border-0 p-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">
                    <%= currentStatus ? currentStatus.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()) + ' Requests' : 'All Service Requests' %>
                </h5>
                <% if (currentStatus) { %>
                    <a href="/admin/services" class="btn btn-sm btn-light rounded-pill">Show All</a>
                    <% } %>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 text-muted small text-uppercase py-3">Customer</th>
                            <th class="text-muted small text-uppercase py-3">Model</th>
                            <th class="text-muted small text-uppercase py-3">Location</th>
                            <th class="text-muted small text-uppercase py-3">Service Date</th>
                            <th class="text-center text-muted small text-uppercase py-3">Status</th>
                            <!-- <th class="text-end pe-4 text-muted small text-uppercase py-3">Actions</th> -->
                        </tr>
                    </thead>

                    <tbody>
                        <% if (services.length===0) { %>
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    No service requests found
                                </td>
                            </tr>
                            <% } %>

                                <% services.forEach(s=> { %>
                                    <tr class="table-row">

                                        <!-- Customer -->
                                        <td class="ps-4 py-3">
                                            <div>
                                                <p class="fw-bold mb-0">
                                                    <%= s.name %>
                                                </p>
                                                <div class="small text-muted">
                                                    <div>
                                                        <%= s.mobile %>
                                                    </div>
                                                    <div>
                                                        <%= s.email %>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>

                                        <!-- Model -->
                                        <td>
                                            <%= s.model %>
                                        </td>

                                        <!-- Location -->
                                        <td>
                                            <% if (s.pickupDrop) { %>

                                                <div>
                                                    <span class="badge bg-warning text-dark mb-1">
                                                        Pickup & Drop
                                                    </span>

                                                    <p class="small text-muted mb-0 location-text">
                                                        <%= s.address %>
                                                    </p>
                                                </div>

                                                <% } else { %>

                                                    <span class="badge bg-light text-dark border">
                                                        <%= s.serviceCentre %>
                                                    </span>

                                                    <% } %>
                                        </td>

                                        <!-- Date -->
                                        <td>
                                            <%= s.preferredDate ? new Date(s.preferredDate).toLocaleDateString('en-GB')
                                                : '-' %>
                                        </td>

                                        <!-- Status -->
                                        <td class="text-center">
                                            <form method="POST" action="/admin/services/<%= s._id %>">
                                                <select name="status"
                                                    class="form-select form-select-sm rounded-pill px-3 status-dropdown"
                                                    onchange="this.form.submit()">
                                                    <option value="pending" <%=s.status==='pending' ?'selected':'' %>
                                                        >Pending</option>
                                                    <option value="confirmed" <%=s.status==='confirmed' ?'selected':''
                                                        %>>Confirmed</option>
                                                    <option value="completed" <%=s.status==='completed' ?'selected':''
                                                        %>>Completed</option>
                                                         <option value="follow-up" <%=s.status==='follow-up' ?'selected':''
                                                        %>>Follow Up</option>
                                                </select>
                                            </form>
                                        </td>

                                        <!-- Actions -->
                                        <!-- <td class="text-end pe-4">
                                            <form method="POST" action="/admin/services/delete/<%= s._id %>"
                                                class="d-inline">
                                                <button class="btn btn-sm btn-outline-danger action-btn">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </form>
                                        </td> -->

                                    </tr>
                                    <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <% if (totalPages> 1) {
            const pageUrl = (p) => `/admin/services?page=${p}&status=${encodeURIComponent(currentStatus)}`;

            // Bounded window: first page, last page, current page ± 2, with "…" for gaps.
            const windowSize = 2;
            const start = Math.max(1, currentPage - windowSize);
            const end = Math.min(totalPages, currentPage + windowSize);

            const rangeStart = (currentPage - 1) * 10 + 1;
            const rangeEnd = Math.min(currentPage * 10, totalRecords);
            %>
            <nav class="mt-4" aria-label="Service requests pagination">
                <ul class="pagination justify-content-center flex-wrap row-gap-2">
                    <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                        <a class="page-link" href="<%= pageUrl(Math.max(1, currentPage - 1)) %>" aria-label="Previous">&laquo;</a>
                    </li>

                    <% if (start> 1) { %>
                        <li class="page-item"><a class="page-link" href="<%= pageUrl(1) %>">1</a></li>
                        <% if (start> 2) { %>
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                            <% } %>
                                <% } %>

                                    <% for(let i=start; i <=end; i++) { %>
                                        <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                            <a class="page-link" href="<%= pageUrl(i) %>">
                                                <%= i %>
                                            </a>
                                        </li>
                                        <% } %>

                                            <% if (end < totalPages) { %>
                                                <% if (end < totalPages - 1) { %>
                                                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                                                    <% } %>
                                                        <li class="page-item"><a class="page-link"
                                                                href="<%= pageUrl(totalPages) %>">
                                                                <%= totalPages %>
                                                            </a></li>
                                                        <% } %>

                                                            <li
                                                                class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                                                                <a class="page-link"
                                                                    href="<%= pageUrl(Math.min(totalPages, currentPage + 1)) %>"
                                                                    aria-label="Next">&raquo;</a>
                                                            </li>
                </ul>
                <p class="text-center text-muted small mt-2 mb-0">
                    Showing <%= rangeStart %>–<%= rangeEnd %> of <%= totalRecords %> service requests
                </p>
            </nav>
            <% } %>
    </div>

    <style>
        body {
            background-color: #f8f9fa;
        }

        /* Stats colors */
        .bg-light-primary {
            background-color: rgba(13, 110, 253, 0.1);
        }

        .bg-light-warning {
            background-color: rgba(255, 193, 7, 0.15);
        }

        .bg-light-success {
            background-color: rgba(25, 135, 84, 0.1);
        }

        .bg-light-info {
            background-color: rgba(13, 202, 240, 0.1);
        }

        .bg-light-secondary {
            background-color: rgba(108, 117, 125, 0.1);
        }

        .extra-small {
            font-size: 0.75rem;
        }

        .stats-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .stats-card {
            transition: transform 0.2s;
        }

        .stats-card:hover {
            transform: translateY(-5px);
        }

        /* Table */
        .table-row {
            transition: background-color 0.2s;
        }

        .table-row:hover {
            background-color: #fcfcfc;
        }

        /* Buttons */
        .action-btn {
            font-size: 1.1rem;
            padding: 6px 10px;
            border-radius: 8px;
        }

        .action-btn:hover {
            background-color: #f8f9fa;
        }

        /* Dropdown */
        .status-dropdown {
            border: 1px solid #eee;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .location-text {
            max-width: 280px;
            white-space: normal;
            line-height: 1.4;
        }
    </style>

    <script>
        const toastEl = document.getElementById("liveToast");
        if (toastEl) {
            new bootstrap.Toast(toastEl, { delay: 2500 }).show();
            const url = new URL(window.location);
            url.searchParams.delete("toast");
            window.history.replaceState({}, document.title, url.pathname + url.search);
        }
    </script>

    <%- include("../partials/footer") %>