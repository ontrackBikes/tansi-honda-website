<%- include("../partials/header") %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="mb-0">Admin Dashboard</h2>
  <a href="/admin/add" class="btn btn-primary">
    + Add Model
  </a>
</div>

<!-- Summary Cards -->
<div class="row mb-4">

  <div class="col-md-4">
    <div class="card shadow-sm">
      <div class="card-body text-center">
        <h5>Total Models</h5>
        <h3><%= models.length %></h3>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card shadow-sm">
      <div class="card-body text-center">
        <h5>Active</h5>
        <h3>
          <%= models.filter(m => m.isActive).length %>
        </h3>
      </div>
    </div>
  </div>

  <div class="col-md-4">
    <div class="card shadow-sm">
      <div class="card-body text-center">
        <h5>Inactive</h5>
        <h3>
          <%= models.filter(m => !m.isActive).length %>
        </h3>
      </div>
    </div>
  </div>

</div>

<!-- Table -->
<div class="card shadow-sm">
  <div class="card-body">

    <h5 class="mb-3">All Models</h5>

    <div class="table-responsive">
      <table class="table table-hover align-middle">

        <thead class="table-dark">
          <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Price</th>
            <th>Status</th>
            <th>Action</th>
          </tr>
        </thead>

        <tbody>

          <% if (models.length === 0) { %>
            <tr>
              <td colspan="5" class="text-center">No models found</td>
            </tr>
          <% } %>

          <% models.forEach(m => { %>
            <tr>

              <!-- Image -->
              <td>
                <img 
                  src="<%= m.image || '/images/default-bike.jpg' %>" 
                  width="80" 
                  class="rounded"
                >
              </td>

              <!-- Name -->
              <td><strong><%= m.name %></strong></td>

              <!-- Price -->
              <td><%= m.price %></td>

              <!-- Status -->
              <td>
                <% if (m.isActive) { %>
                  <span class="badge bg-success">Active</span>
                <% } else { %>
                  <span class="badge bg-secondary">Inactive</span>
                <% } %>
              </td>

              <!-- Actions -->
              <td>
                <a href="/admin/edit/<%= m._id %>" class="btn btn-sm btn-warning me-1">
                  Edit
                </a>

                <!-- Optional Delete -->
                <form 
                  action="/admin/delete/<%= m._id %>" 
                  method="POST" 
                  style="display:inline;"
                  onsubmit="return confirm('Delete this model?')"
                >
                  <button class="btn btn-sm btn-danger">
                    Delete
                  </button>
                </form>

              </td>

            </tr>
          <% }) %>

        </tbody>

      </table>
    </div>

  </div>
</div>

<%- include("../partials/footer") %>