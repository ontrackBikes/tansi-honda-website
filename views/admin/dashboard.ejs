<%- include("../partials/header") %>

<div class="container py-5">
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-5">
    <!-- Left Side -->
    <div>
      <h2 class="fw-bold mb-1">Admin Dashboard</h2>
      <p class="text-muted mb-0">Manage your system efficiently</p>
    </div>

    <!-- Right Side (Logout Button) -->
    <a
      href="/admin/logout"
      class="btn btn-outline-danger px-4 py-2 fw-semibold rounded-3"
    >
      <i class="bi bi-box-arrow-right me-2"></i>Logout
    </a>
  </div>

  <!-- Large Cards -->
  <div class="row g-4">
    <!-- Models -->
    <div class="col-md-6">
      <a href="/admin/models" class="text-decoration-none">
        <div class="card border-0 shadow-sm rounded-4 p-4 dashboard-card h-100">
          <div class="d-flex align-items-center h-100">
            <div class="icon-box bg-light-red text-danger me-4">
              <i class="bi bi-box-seam"></i>
            </div>

            <div>
              <h4 class="fw-bold mb-2 text-dark">Manage Models</h4>
              <p class="text-muted mb-0">
                Add, update, and manage all bike models in your system
              </p>
            </div>
          </div>
        </div>
      </a>
    </div>

    <!-- Leads -->
    <div class="col-md-6">
      <a href="/admin/leads" class="text-decoration-none">
        <div class="card border-0 shadow-sm rounded-4 p-4 dashboard-card h-100">
          <div class="d-flex align-items-center h-100">
            <div class="icon-box bg-light-primary text-primary me-4">
              <i class="bi bi-person-lines-fill"></i>
            </div>

            <div>
              <h4 class="fw-bold mb-2 text-dark">Manage Leads</h4>
              <p class="text-muted mb-0">Track customer inquiries</p>
            </div>
          </div>
        </div>
      </a>
    </div>

    <!-- Service Appointments -->
    <div class="col-md-6">
      <a href="/admin/services" class="text-decoration-none">
        <div class="card border-0 shadow-sm rounded-4 p-4 dashboard-card h-100">
          <div class="d-flex align-items-center h-100">
            <div class="icon-box bg-light-success text-success me-4">
              <i class="bi bi-tools"></i>
            </div>

            <div>
              <h4 class="fw-bold mb-2 text-dark">Service Appointments</h4>
              <p class="text-muted mb-0">
                View, track, and manage all service bookings
              </p>
            </div>
          </div>
        </div>
      </a>
    </div>
  </div>
</div>

<style>
  body {
    background-color: #f8f9fa;
  }

  /* Dashboard Cards */
  .dashboard-card {
    min-height: 160px;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .dashboard-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
  }

  /* Icon Box */
  .icon-box {
    width: 70px;
    height: 70px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon-box i {
    font-size: 28px;
  }

  /* Colors */
  .bg-light-red {
    background: rgba(230, 0, 18, 0.1);
  }

  .bg-light-success {
    background: rgba(25, 135, 84, 0.1);
  }

  .bg-light-primary {
    background: rgba(13, 110, 253, 0.1);
  }
</style>

<%- include("../partials/footer") %>
