<%- include("../partials/header") %>

<h2 class="mb-4">Edit Model</h2>

<a href="/admin" class="btn btn-link mb-3">← Back</a>

<form action="/admin/edit/<%= model._id %>" method="POST">

<div class="row">

<div class="col-md-6">

<div class="mb-3">
<label>Model Name</label>
<input name="name" class="form-control" value="<%= model.name %>">
</div>

<div class="mb-3">
<label>Category</label>
<select name="category" class="form-select">
<option <%= model.category==='Bike'?'selected':'' %>>Bike</option>
<option <%= model.category==='Scooter'?'selected':'' %>>Scooter</option>
<option <%= model.category==='Touring'?'selected':'' %>>Touring</option>
</select>
</div>

<div class="mb-3">
<label>Description</label>
<textarea name="description" class="form-control"><%= model.description %></textarea>
</div>

<div class="mb-3">
<label>Features</label>
<input name="features" class="form-control"
value="<%= model.features?.join(', ') %>">
</div>

<h5 class="mt-4">Specifications</h5>

<div class="row">
<input name="engine" class="form-control mb-2" value="<%= model.specs?.engine %>" placeholder="Engine">
<input name="mileage" class="form-control mb-2" value="<%= model.specs?.mileage %>" placeholder="Mileage">
<input name="power" class="form-control mb-2" value="<%= model.specs?.power %>" placeholder="Power">
<input name="torque" class="form-control mb-2" value="<%= model.specs?.torque %>" placeholder="Torque">
<input name="fuel_type" class="form-control mb-2" value="<%= model.specs?.fuel_type %>" placeholder="Fuel Type">
<input name="transmission" class="form-control mb-2" value="<%= model.specs?.transmission %>" placeholder="Transmission">
</div>

<div class="form-check mt-2">
<input type="checkbox" name="isActive"
<%= model.isActive?'checked':'' %>>
<label>Active</label>
</div>

</div>

<div class="col-md-6">

<input type="file" id="imageInput" class="form-control mb-3">

<input type="hidden" name="image" id="imageUrl" value="<%= model.image %>">

<img id="previewImage"
src="<%= model.image %>"
class="img-fluid rounded">

<p id="uploadStatus"></p>

</div>

</div>

<button class="btn btn-primary mt-3">Update</button>

</form>

<script>
const imageInput = document.getElementById("imageInput");
const preview = document.getElementById("previewImage");
const imageUrlInput = document.getElementById("imageUrl");

imageInput.addEventListener("change", async () => {
const file = imageInput.files[0];
const formData = new FormData();
formData.append("image", file);

const res = await fetch("/admin/upload-image", {
method: "POST",
body: formData
});

const data = await res.json();

if (data.url) {
imageUrlInput.value = data.url;
preview.src = data.url;
}
});
</script>

<%- include("../partials/footer") %>