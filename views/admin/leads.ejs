<%- include("../partials/admin-header") %>

    <div class="container py-4 min-vh-100">

        <div class="position-fixed top-0 end-0 p-3" style="z-index: 1080">
            <% if (toast==='updated' ) { %>
                <div id="liveToast" class="toast align-items-center text-bg-success border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body">
                            <i class="bi bi-check-circle-fill me-2"></i> Lead status updated successfully
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto"
                            data-bs-dismiss="toast"></button>
                    </div>
                </div>
                <% } %>
                    <% if (toast==='deleted' ) { %>
                        <div id="liveToast" class="toast align-items-center text-bg-danger border-0" role="alert">
                            <div class="d-flex">
                                <div class="toast-body">
                                    <i class="bi bi-trash-fill me-2"></i> Lead deleted successfully
                                </div>
                                <button type="button" class="btn-close btn-close-white me-2 m-auto"
                                    data-bs-dismiss="toast"></button>
                            </div>
                        </div>
                        <% } %>
        </div>

        <div class="mb-5">
            <h2 class="fw-bold mb-1">Website Leads</h2>
            <p class="text-muted small">Manage and track customer inquiries.</p>
        </div>

        <div class="row g-3 mb-5">
            <div class="col-6 col-sm-6 col-md-2">
                <a href="/admin/leads?from=<%= from %>&to=<%= to %>" class="text-decoration-none">
                    <div
                        class="card border-0 shadow-sm rounded-4 p-3 stats-card stats-hover <%= !currentStatus ? 'border-active-primary' : '' %>">
                        <div class="d-flex align-items-center">
                            <div class="stats-icon bg-light-primary text-primary me-2">
                                <i class="bi bi-people fs-5"></i>
                            </div>
                            <div>
                                <p class="text-muted extra-small mb-0 fw-semibold">Total</p>
                                <h4 class="fw-bold mb-0 text-dark">
                                    <%= stats.total %>
                                </h4>
                            </div>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-6 col-sm-6 col-md-2">
                <a href="/admin/leads?status=New&from=<%= from %>&to=<%= to %>" class="text-decoration-none">
                    <div
                        class="card border-0 shadow-sm rounded-4 p-3 stats-card stats-hover <%= currentStatus === 'New' ? 'border-active-warning' : '' %>">
                        <div class="d-flex align-items-center">
                            <div class="stats-icon bg-light-warning text-warning me-2">
                                <i class="bi bi-person-plus fs-5"></i>
                            </div>
                            <div>
                                <p class="text-muted extra-small mb-0 fw-semibold">New</p>
                                <h4 class="fw-bold mb-0 text-dark">
                                    <%= stats.new %>
                                </h4>
                            </div>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-6 col-sm-6 col-md-2">
                <a href="/admin/leads?status=Contacted&from=<%= from %>&to=<%= to %>" class="text-decoration-none">
                    <div
                        class="card border-0 shadow-sm rounded-4 p-3 stats-card stats-hover <%= currentStatus === 'Contacted' ? 'border-active-info' : '' %>">
                        <div class="d-flex align-items-center">
                            <div class="stats-icon bg-light-info text-info me-2">
                                <i class="bi bi-telephone fs-5"></i>
                            </div>
                            <div>
                                <p class="text-muted extra-small mb-0 fw-semibold">Contacted</p>
                                <h4 class="fw-bold mb-0 text-dark">
                                    <%= stats.contacted %>
                                </h4>
                            </div>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-6 col-sm-6 col-md-2">
                <a href="/admin/leads?status=Interested&from=<%= from %>&to=<%= to %>" class="text-decoration-none">
                    <div
                        class="card border-0 shadow-sm rounded-4 p-3 stats-card stats-hover <%= currentStatus === 'Interested' ? 'border-active-success' : '' %>">
                        <div class="d-flex align-items-center">
                            <div class="stats-icon bg-light-success text-success me-2">
                                <i class="bi bi-check-circle fs-5"></i>
                            </div>
                            <div>
                                <p class="text-muted extra-small mb-0 fw-semibold">Interested</p>
                                <h4 class="fw-bold mb-0 text-dark">
                                    <%= stats.interested %>
                                </h4>
                            </div>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-6 col-sm-6 col-md-2">
                <a href="/admin/leads?status=Not Interested&from=<%= from %>&to=<%= to %>" class="text-decoration-none">
                    <div
                        class="card border-0 shadow-sm rounded-4 p-3 stats-card stats-hover <%= currentStatus === 'Not Interested' ? 'border-active-danger' : '' %>">
                        <div class="d-flex align-items-center">
                            <div class="stats-icon bg-light-danger text-danger me-2">
                                <i class="bi bi-x-circle fs-5"></i>
                            </div>
                            <div>
                                <p class="text-muted extra-small mb-0 fw-semibold">Not Interested</p>
                                <h4 class="fw-bold mb-0 text-dark">
                                    <%= stats.notInterested %>
                                </h4>
                            </div>
                        </div>
                    </div>
                </a>
            </div>

            <div class="col-6 col-sm-6 col-md-2">
                <a href="/admin/leads?status=Follow-up&from=<%= from %>&to=<%= to %>" class="text-decoration-none">
                    <div
                        class="card border-0 shadow-sm rounded-4 p-3 stats-card stats-hover <%= currentStatus === 'Follow-up' ? 'border-active-secondary' : '' %>">
                        <div class="d-flex align-items-center">
                            <div class="stats-icon bg-light-secondary text-secondary me-2">
                                <i class="bi bi-clock-history fs-5"></i>
                            </div>
                            <div>
                                <p class="text-muted extra-small mb-0 fw-semibold">Follow Up</p>
                                <h4 class="fw-bold mb-0 text-dark">
                                    <%= stats.followUp %>
                                </h4>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        </div>

        <form method="GET" action="/admin/leads" class="mb-5">
            <input type="hidden" name="status" value="<%= currentStatus %>">
            <div class="card border-0 shadow-sm rounded-4 p-4 stats-card ">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="small text-muted mb-1">From Date</label>
                        <input type="date" name="from" value="<%= from %>" class="form-control rounded-pill">
                    </div>
                    <div class="col-md-3">
                        <label class="small text-muted mb-1">To Date</label>
                        <input type="date" name="to" value="<%= to %>" class="form-control rounded-pill">
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-dark rounded-pill w-100">Filter Data</button>
                    </div>
                    <div class="col-md-2">
                        <a href="/admin/leads" class="btn btn-outline-secondary rounded-pill w-100">Clear All</a>
                    </div>
                    <div class="col-md-2">
                        <a href="/admin/leads/export/csv?from=<%= from %>&to=<%= to %>&status=<%= currentStatus %>"
                            class="btn btn-success rounded-pill w-100">
                            CSV Export
                        </a>
                    </div>
                </div>
            </div>
        </form>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-white border-0 p-4 d-flex justify-content-between">
                <h5 class="fw-bold mb-0">
                    <%= currentStatus ? currentStatus + ' Leads' : 'All Leads' %>
                </h5>
                <% if(currentStatus) { %>
                    <a href="/admin/leads?from=<%= from %>&to=<%= to %>" class="btn btn-sm btn-light rounded-pill">Show
                        All</a>
                    <% } %>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 text-muted small text-uppercase py-3">Customer</th>
                            <th class="text-muted small text-uppercase py-3">Bike</th>
                            <th class="text-muted small text-uppercase py-3">Type</th>
                            <th class="text-muted small text-uppercase py-3">Date</th>
                            <th class="text-center text-muted small text-uppercase py-3">Status</th>
                            <!-- <th class="text-end pe-4 text-muted small text-uppercase py-3">Actions</th> -->
                        </tr>
                    </thead>
                    <tbody>
                        <% if (leads.length===0) { %>
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">No leads found for this filter</td>
                            </tr>
                            <% } %>
                                <% leads.forEach(l=> { %>
                                    <tr class="table-row">
                                        <td class="ps-4">
                                            <p class="fw-bold mb-0">
                                                <%= l.name %>
                                            </p>
                                            <small class="text-muted">
                                                <%= l.phone %>
                                            </small>
                                        </td>
                                        <td>
                                            <span class="fw-semibold">
                                                <%= l.modelName %>
                                            </span><br>
                                            <small class="text-muted">
                                                <%= l.variantName || '-' %>
                                            </small>
                                        </td>
                                        <td><span class="badge bg-light text-dark border rounded-pill">
                                                <%= l.source %>
                                            </span></td>
                                        <td>
                                            <%= new Date(l.createdAt).toLocaleDateString('en-GB', {
                                                timeZone: 'Asia/Kolkata' }) %><br>

                                                <small class="text-muted">
                                                    <%= new Date(l.createdAt).toLocaleTimeString('en-IN', {
                                                        timeZone: 'Asia/Kolkata' , hour: '2-digit' , minute: '2-digit' ,
                                                        hour12: true }) %>
                                                </small>
                                        </td>
                                        <td class="text-center">
                                            <form method="POST" action="/admin/leads/<%= l._id %>">
                                                <select name="status"
                                                    class="form-select form-select-sm rounded-pill status-dropdown"
                                                    onchange="this.form.submit()">
                                                    <option value="New" <%=l.status==='New' ? 'selected' : '' %>>New
                                                    </option>
                                                    <option value="Contacted" <%=l.status==='Contacted' ? 'selected'
                                                        : '' %>>Contacted</option>
                                                    <option value="Interested" <%=l.status==='Interested' ? 'selected'
                                                        : '' %>>Interested</option>
                                                    <option value="Not Interested" <%=l.status==='Not Interested'
                                                        ? 'selected' : '' %>>Not Interested</option>
                                                    <option value="Follow-up" <%=l.status==='Follow-up' ? 'selected'
                                                        : '' %>>Follow-up</option>
                                                </select>
                                            </form>
                                        </td>
                                        <!-- <td class="text-end pe-4">
                                            <form method="POST" action="/admin/leads/delete/<%= l._id %>"
                                                class="d-inline" onsubmit="return confirm('Delete this lead?')">
                                                <button class="btn btn-sm btn-outline-danger"><i
                                                        class="bi bi-trash3"></i></button>
                                            </form>
                                        </td> -->
                                    </tr>
                                    <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <% if(totalPages> 1) { %>
            <nav class="mt-4">
                <ul class="pagination justify-content-center">
                    <% for(let i=1; i <=totalPages; i++) { %>
                        <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                            <a class="page-link"
                                href="/admin/leads?page=<%= i %>&from=<%= from %>&to=<%= to %>&status=<%= currentStatus %>">
                                <%= i %>
                            </a>
                        </li>
                        <% } %>
                </ul>
            </nav>
            <% } %>

    </div>

    <style>
        body {
            background-color: #f8f9fa;
        }

        .extra-small {
            font-size: 0.75rem;
        }

        .bg-light-danger {
            background-color: rgba(220, 53, 69, 0.1);
        }

        .bg-light-secondary {
            background-color: rgba(108, 117, 125, 0.1);
        }

        .stats-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .stats-card {
            transition: all 0.2s;
            cursor: pointer;
            border: 2px solid transparent;
        }

        .stats-hover:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05) !important;
        }

        .bg-light-primary {
            background-color: rgba(13, 110, 253, 0.1);
        }

        .bg-light-warning {
            background-color: rgba(255, 193, 7, 0.15);
        }

        .bg-light-success {
            background-color: rgba(25, 135, 84, 0.1);
        }

        .bg-light-info {
            background-color: rgba(13, 202, 240, 0.1);
        }

        .status-dropdown {
            font-size: 0.75rem;
            font-weight: 600;
            width: 130px;
            margin: 0 auto;
        }
    </style>

    <script>
        const toastEl = document.getElementById('liveToast');
        if (toastEl) {
            new bootstrap.Toast(toastEl, { delay: 2500 }).show();
            const url = new URL(window.location);
            url.searchParams.delete("toast");
            window.history.replaceState({}, document.title, url.pathname + url.search);
        }
    </script>

    <%- include("../partials/footer") %>