<!doctype html>
<html lang="en">
  <head>
    <link
      rel="icon"
      type="image/x-icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏍️</text></svg>"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,600;14..32,700;14..32,800&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
    />

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        background-color: #ffffff;
        color: black;
        line-height: 1.5;
        scroll-behavior: smooth;
      }
      .container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 15px 20px;
      }

      .footer {
        background: black;
        color: #cbd5e1;
        padding: 48px 0 24px;
        margin-top: 60px;
      }
      .footer-inner {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 30px;
      }
      .footer-col {
        min-width: 160px;
      }
      .footer-col a {
        color: #cbd5e1;
        text-decoration: none;
        display: block;
        margin: 8px 0;
        font-size: 0.9rem;
      }
      .footer-col a:hover {
        color: #e60012;
      }
    </style>
  </head>
  <body>
    <!-- Footer -->
    <footer class="footer">
      <div class="container footer-inner">
        <div class="footer-col">
          <h5 class="fw-bold" style="color: white">Tansi Honda</h5>
          <p>
            Your trusted Honda partner since 2005.<br />Click. Book. Relax.
            Experience the joy of Honda at home.
          </p>
        </div>
        <div class="footer-col">
          <h5 class="fw-bold">Quick Links</h5>

          <!-- <a href="/about-us">About Us</a> -->
          <a href="/contact-us">Contact Us</a>
          <a href="/directions">Directions</a>
        </div>
        <div class="footer-col">
          <h5 class="fw-bold">Services</h5>
          <a href="/book-service">Service Booking</a>
          <!-- <a href="/apply-insurance">Insurance Renewal</a>
          <a href="/spare-parts-query">Spare Parts</a> -->
        </div>
        <div class="footer-col">
          <h5 class="fw-bold">Connect</h5>
          <a href="https://www.facebook.com/tansimotors/" target="_blank"
            ><i class="fab fa-facebook"></i> Facebook</a
          >
          <a href="https://www.instagram.com/tansimotors/" target="_blank"
            ><i class="fab fa-instagram"></i> Instagram</a
          >
          <a
            href="https://www.youtube.com/channel/UCVgu65AutXuefrSK2QHUzWg"
            target="_blank"
            ><i class="fab fa-youtube"></i> YouTube</a
          >
        </div>
      </div>
      <div
        class="container"
        style="
          text-align: center;
          border-top: 1px solid #2d3748;
          margin-top: 40px;
          padding-top: 24px;
        "
      >
        <p>
          © <span id="currentYear"></span> Tansi Honda – All Rights Reserved.
        </p>
        <!-- <p style="font-size: 0.7rem">
          *T&C apply. Offers valid for limited period. Images for
          representation.
        </p> -->
      </div>
    </footer>
  </body>
</html>

<script>
  document.getElementById("currentYear").textContent = new Date().getFullYear();
</script>
