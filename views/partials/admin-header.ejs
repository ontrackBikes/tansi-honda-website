<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <title>Tansi Honda | Authorised Honda Dealer Bangalore</title>
    <!-- Basic SEO -->
    <meta
      name="description"
      content="Tansi Honda – Official Honda 2Wheeler dealer in Bangalore. Book bikes, scooters & EVs online."
    />

    <link
      rel="shortcut icon"
      type="image/x-icon"
      href="/images/fav/favicon.ico"
    />

    <link rel="stylesheet" href="/css/style.css" />
    <!-- Fonts -->

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto+Mono:ital,wght@0,100..700;1,100..700&display=swap"
      rel="stylesheet"
    />

    <!-- Icons -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <style>
      /* ---------- RESET & GLOBAL ALIGNMENT ---------- */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background-color: #ffffff;
        color: #1e1e2f;
        line-height: 1.5;
        scroll-behavior: smooth;
      }

      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        font-family: "Roboto Mono", monospace !important;
      }

      /* consistent container - aligns all core content */
      .container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 24px;
      }

      @media (max-width: 640px) {
        .container {
          padding: 0 20px;
        }
      }

      /* ---------- MAIN HEADER: STICKY, SHARP ALIGNMENT ---------- */
      .main-header {
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(2px);
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.04);
        position: sticky;
        top: 0;
        z-index: 1000;
        width: 100%;
      }

      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
      }

      /* LOGO — perfect vertical alignment */
      .logo {
        line-height: 1.2;
      }

      .logo h1 {
        font-size: 1.75rem;
        font-weight: 800;
        background: #e60012;
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        letter-spacing: -0.3px;
        margin: 0;
        padding: 0;
      }

      .logo span {
        font-size: 0.7rem;
        font-weight: 500;
        color: #4a5568;
        display: block;
        letter-spacing: 0.3px;
        margin-top: 2px;
      }

      /* navigation links — perfectly centered relative to logo */
      .nav-links {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        list-style: none;
        margin: 0;
        padding: 0;
        align-items: center;
      }

      .nav-links li a {
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        color: #2d3748;
        transition: 0.2s;
        padding: 6px 0;
        border-bottom: 2px solid transparent;
        display: inline-block;
      }

      .nav-links li a:hover,
      .nav-links li a.active {
        color: #e60012;
        border-bottom-color: #e60012;
      }

      /* mobile menu icon */
      .mobile-menu-icon {
        display: none;
        font-size: 1.8rem;
        cursor: pointer;
        color: #e60012;
        transition: 0.2s;
        background: transparent;
        border: none;
        line-height: 1;
      }

      .mobile-menu-icon:hover {
        opacity: 0.8;
      }

      /* responsive header */
      @media (max-width: 1024px) {
        .nav-links {
          display: none;
          width: 100%;
          flex-direction: column;
          background: white;
          padding: 20px 24px;
          border-radius: 24px;
          box-shadow: 0 20px 30px rgba(0, 0, 0, 0.08);
          margin-top: 8px;
          gap: 12px;
        }

        .nav-links.show {
          display: flex;
        }

        .mobile-menu-icon {
          display: block;
        }

        .header-inner {
          position: relative;
        }

        .nav-links li a {
          padding: 12px 0;
          font-size: 1rem;
          border-bottom: none;
          width: 100%;
        }

        .nav-links li a:hover {
          border-bottom: none;
          background: #fff5f5;
          padding-left: 12px;
          border-radius: 12px;
        }
      }

      @media (max-width: 768px) {
        .logo h1 {
          font-size: 1.45rem;
        }

        .logo span {
          font-size: 0.6rem;
        }
      }

      /* remove default bootstrap interference but keep useful */
      .mb-0 {
        margin-bottom: 0 !important;
      }

      .button-custom {
        background: #e60012;
        border: 1px solid #e60012;
        padding: 5px 20px;
        border-radius: 50px;
        font-weight: 600;
        transition: 0.2s;
        text-decoration: none;
        color: #f7f3f3;
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-size: 0.9rem;
      }

      /* Dropdown Base Styles */
      .dropdown-parent {
        position: relative;
      }

      .sub-menu,
      .nested-menu {
        list-style: none;
        position: absolute;
        background: #ffffff;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        /* border-top: 3px solid #e60012; */
        padding: 10px 0;
        min-width: 200px;
        display: none;
        /* Hidden by default */
        z-index: 1010;
      }

      .sub-menu {
        top: 100%;
        left: 0;
      }

      /* Nested (Level 2) positioning */
      .nested-menu {
        top: -3px;
        /* Align with top of parent li */
        left: 100%;
      }

      /* Show menus on hover */
      .dropdown-parent:hover > .sub-menu {
        display: block;
      }

      .has-children:hover > .nested-menu {
        display: block;
      }

      /* Dropdown Item Styling */
      .sub-menu li a,
      .nested-menu li a {
        padding: 10px 20px !important;
        font-size: 0.85rem !important;
        display: flex !important;
        justify-content: space-between;
        align-items: center;
        color: #2d3748 !important;
        border: none !important;
        width: 100%;
      }

      .sub-menu li a:hover,
      .nested-menu li a:hover {
        background: #fff5f5 !important;
        color: #e60012 !important;
      }

      /* Responsive fix: On mobile, dropdowns can be tricky. 
   This simple tweak stack them. */
      @media (max-width: 1024px) {
        .sub-menu,
        .nested-menu {
          position: static;
          box-shadow: none;
          border: none;
          padding-left: 20px;
          display: none;
        }

        .nav-links.show .dropdown-parent:hover .sub-menu,
        .nav-links.show .has-children:hover .nested-menu {
          display: block;
        }
      }
    </style>
  </head>

  <body>
    <!-- MAIN HEADER: sticky with clean alignment -->
    <header class="main-header">
      <div class="container">
        <div class="header-inner">
          <div class="logo">
            <a href="/" style="text-decoration: none">
              <h1>Tansi Honda</h1>
            </a>
          </div>
          <button class="mobile-menu-icon" id="menuToggle" aria-label="Menu">
            <i class="fas fa-bars"></i>
          </button>
          <ul class="nav-links" id="navLinks">
            <!-- class="active" use for active  -->
            <li><a href="/admin">Home</a></li>
            <li><a href="/admin/models">Models</a></li>
            <li><a href="/admin/leads">Leads</a></li>
            <li><a href="/admin/services">Services</a></li>
            <li><a href="/admin/contact-us">Contact</a></li>
          </ul>
        </div>
      </div>
    </header>

    <!-- JavaScript for mobile menu toggle -->
    <script>
      (function () {
        const menuToggle = document.getElementById("menuToggle");
        const navLinks = document.getElementById("navLinks");

        if (menuToggle && navLinks) {
          menuToggle.addEventListener("click", (e) => {
            e.stopPropagation();
            navLinks.classList.toggle("show");
          });

          // Optional: close menu when clicking outside (enhances UX)
          document.addEventListener("click", function (event) {
            const isClickInsideNav = navLinks.contains(event.target);
            const isClickOnToggle = menuToggle.contains(event.target);
            if (
              !isClickInsideNav &&
              !isClickOnToggle &&
              navLinks.classList.contains("show")
            ) {
              navLinks.classList.remove("show");
            }
          });
        }
      })();
    </script>
    <!-- No extra style overrides — everything aligned & polished -->
  </body>
</html>
