<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <title>Tansi Honda | Authorised Honda Dealer Bangalore</title>
    <!-- Basic SEO -->
    <meta
      name="description"
      content="Tansi Honda – Official Honda 2Wheeler dealer in Bangalore. Book bikes, scooters & EVs online."
    />
    <!-- Favicon -->
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏍️</text></svg>"
    />
    <!-- Fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap"
      rel="stylesheet"
    />
    <!-- Icons -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <style>
      /* ---------- RESET & GLOBAL ALIGNMENT ---------- */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Inter", sans-serif;
        background-color: #ffffff;
        color: #1e1e2f;
        line-height: 1.5;
        scroll-behavior: smooth;
      }

      /* consistent container - aligns all core content */
      .container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 24px;
      }

      /* ---------- TOP BAR: FULL WIDTH, CONTENT INSIDE CONTAINER (PERFECT ALIGNMENT) ---------- */
      .top-bar {
        background: #1a1a2c;
        color: #f5f5f5;
        font-size: 0.85rem;
        font-weight: 500;
        border-bottom: 2px solid #e60012;
        width: 100%;
      }

      .top-bar .container {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-start;
        gap: 28px;
        padding-top: 10px;
        padding-bottom: 10px;
      }

      /* top bar individual blocks */
      .top-bar-item {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
      }

      .top-bar a {
        color: #ffffff;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }

      .top-bar a:hover {
        color: #e60012;
      }

      .top-bar i {
        font-size: 0.9rem;
        color: #e60012;
        width: 1.2rem;
        text-align: center;
      }

      /* responsive top bar: wrap gracefully */
      @media (max-width: 900px) {
        .top-bar .container {
          gap: 16px;
          justify-content: flex-start;
          row-gap: 8px;
        }
        .top-bar-item {
          white-space: normal;
          flex-wrap: wrap;
        }
      }

      @media (max-width: 640px) {
        .container {
          padding: 0 20px;
        }
        .top-bar .container {
          gap: 12px;
          flex-direction: row;
          flex-wrap: wrap;
        }
        .top-bar-item {
          font-size: 0.75rem;
        }
      }

      /* ---------- MAIN HEADER: STICKY, SHARP ALIGNMENT ---------- */
      .main-header {
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(2px);
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.04);
        position: sticky;
        top: 0;
        z-index: 1000;
        width: 100%;
      }

      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;

        gap: 16px;
      }

      /* LOGO — perfect vertical alignment */
      .logo {
        line-height: 1.2;
      }

      .logo h1 {
        font-size: 1.75rem;
        font-weight: 800;
        background: linear-gradient(135deg, #e60012, #b91c1c);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        letter-spacing: -0.3px;
        margin: 0;
        padding: 0;
      }

      .logo span {
        font-size: 0.7rem;
        font-weight: 500;
        color: #4a5568;
        display: block;
        letter-spacing: 0.3px;
        margin-top: 2px;
      }

      /* navigation links — perfectly centered relative to logo */
      .nav-links {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        list-style: none;
        margin: 0;
        padding: 0;
        align-items: center;
      }

      .nav-links li a {
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        color: #2d3748;
        transition: 0.2s;
        padding: 6px 0;
        border-bottom: 2px solid transparent;
        display: inline-block;
      }

      .nav-links li a:hover,
      .nav-links li a.active {
        color: #e60012;
        border-bottom-color: #e60012;
      }

      /* mobile menu icon */
      .mobile-menu-icon {
        display: none;
        font-size: 1.8rem;
        cursor: pointer;
        color: #e60012;
        transition: 0.2s;
        background: transparent;
        border: none;
        line-height: 1;
      }

      .mobile-menu-icon:hover {
        opacity: 0.8;
      }

      /* responsive header */
      @media (max-width: 1024px) {
        .nav-links {
          display: none;
          width: 100%;
          flex-direction: column;
          background: white;
          padding: 20px 24px;
          border-radius: 24px;
          box-shadow: 0 20px 30px rgba(0, 0, 0, 0.08);
          margin-top: 8px;
          gap: 12px;
        }
        .nav-links.show {
          display: flex;
        }
        .mobile-menu-icon {
          display: block;
        }
        .header-inner {
          position: relative;
        }
        .nav-links li a {
          padding: 12px 0;
          font-size: 1rem;
          border-bottom: none;
          width: 100%;
        }
        .nav-links li a:hover {
          border-bottom: none;
          background: #fff5f5;
          padding-left: 12px;
          border-radius: 12px;
        }
      }

      @media (max-width: 768px) {
        .logo h1 {
          font-size: 1.45rem;
        }
        .logo span {
          font-size: 0.6rem;
        }
      }

      /* extra fine tuning for perfect icon-text baseline */
      .top-bar-item i,
      .top-bar a i {
        vertical-align: middle;
      }

      /* remove default bootstrap interference but keep useful */
      .mb-0 {
        margin-bottom: 0 !important;
      }

      /* alignment helper — ensures that all edges match container */
      .top-bar,
      .main-header {
        width: 100%;
      }
    </style>
  </head>
  <body>
    <!-- TOP BAR: fully aligned with header container (same left/right padding) -->
    <div class="top-bar">
      <div class="container">
        <div class="top-bar-item">
          <i class="fas fa-motorcycle"></i> Sales:
          <a href="tel:7259030091">7259030091</a>
        </div>
        <div class="top-bar-item">
          <i class="fas fa-tools"></i> Service:
          <a href="tel:7259586972">7259586972</a>
        </div>
        <div class="top-bar-item">
          <i class="fas fa-phone-alt"></i> Toll-Free:
          <a href="tel:18005329444">1800 532 9444</a>
        </div>
        <div class="top-bar-item">
          <i class="fas fa-map-marker-alt"></i>
          <a href="#">Tansi Honda Assistance</a>
          <span style="color: #aaa">|</span>
          <a href="#">Contact Us</a>
        </div>
      </div>
    </div>

    <!-- MAIN HEADER: sticky with clean alignment -->
    <header class="main-header">
      <div class="container">
        <div class="header-inner">
          <div class="logo">
            <h1 class="mb-0">TANSI HONDA</h1>
            <span>Authorised Dealer | Click. Book. Relax.</span>
          </div>
          <button class="mobile-menu-icon" id="menuToggle" aria-label="Menu">
            <i class="fas fa-bars"></i>
          </button>
          <ul class="nav-links" id="navLinks">
            <li><a href="/" class="active">Home</a></li>
            <li><a href="/models">Models</a></li>
            <li><a href="#">Motor Cycles</a></li>
            <li><a href="#">Scooters</a></li>
            <li><a href="#">EV</a></li>
            <li><a href="#">Brochures</a></li>
            <li><a href="#">Red Wing</a></li>
            <li><a href="#">BigWing</a></li>
            <li><a href="#">EV Services</a></li>
            <li><a href="#">Special Offers</a></li>
            <li><a href="#">Contact Us</a></li>
          </ul>
        </div>
      </div>
    </header>

    <!-- JavaScript for mobile menu toggle -->
    <script>
      (function () {
        const menuToggle = document.getElementById("menuToggle");
        const navLinks = document.getElementById("navLinks");

        if (menuToggle && navLinks) {
          menuToggle.addEventListener("click", (e) => {
            e.stopPropagation();
            navLinks.classList.toggle("show");
          });

          // Optional: close menu when clicking outside (enhances UX)
          document.addEventListener("click", function (event) {
            const isClickInsideNav = navLinks.contains(event.target);
            const isClickOnToggle = menuToggle.contains(event.target);
            if (
              !isClickInsideNav &&
              !isClickOnToggle &&
              navLinks.classList.contains("show")
            ) {
              navLinks.classList.remove("show");
            }
          });
        }
      })();
    </script>
    <!-- No extra style overrides — everything aligned & polished -->
  </body>
</html>
