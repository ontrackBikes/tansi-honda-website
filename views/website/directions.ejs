      sales: "8971221818",
      service: "7899512512",
      insurance: "8971221818",
      finance: "9741410101",
      spares: "7899512512",
      map: "https://www.google.com/maps/d/embed?mid=1TsG7QBzueBxvpfVj2cX-JsI-e5c7nXc&ehbc=2E312F",
    },
    {
      name: "Gunjur",
