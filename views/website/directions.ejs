      map: "https://www.google.com/maps/d/embed?mid=1TsG7QBzueBxvpfVj2cX-JsI-e5c7nXc&ehbc=2E312F",
    },
    {
      name: "Marathahalli",
      address: "Outer Ring Road Junction, Marathahalli, Bangalore - 560037",
      sales: "7259030100",
      service: "7619207143",
      insurance: "7259030093",
      finance: "7259030093",
      spares: "7619207143",
      map: "https://www.google.com/maps/d/embed?mid=1TsG7QBzueBxvpfVj2cX-JsI-e5c7nXc&ehbc=2E312F",
    },
    {
