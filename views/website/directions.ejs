      finance: "9343000000",
      spares: "9343000001",
      map: "https://www.google.com/maps?q=hrbr%20layout%20bangalore&output=embed",
    },
  ];

  const card = document.getElementById("locationCard");
  const map = document.getElementById("mapFrame");
  const select = document.getElementById("locationSelect");

  function renderLocation(index) {
    const loc = locations[index];

    card.innerHTML = `
      <h3>${loc.name}</h3>
      <p class="address">${loc.address}</p>

      <div class="cta-row">
        <a href="tel:${loc.sales}" class="button-custom">
          <i class="fas fa-phone"></i> Call
        </a>
        <a href="https://wa.me/91${loc.sales}" class="outline-btn">
          <i class="fab fa-whatsapp"></i> WhatsApp
        </a>
      </div>

      <div class="contact-box">
        <p><strong>Sales:</strong> ${loc.sales}</p>
        <p><strong>Service:</strong> ${loc.service}</p>
        <p><strong>Insurance:</strong> ${loc.insurance}</p>
        <p><strong>Finance:</strong> ${loc.finance}</p>
        <p><strong>Spares:</strong> ${loc.spares}</p>
      </div>
    `;

    map.src = loc.map;
  }

  select.addEventListener("change", (e) => {
    renderLocation(e.target.value);
  });

  renderLocation(0);
</script>

<style>
  .direction-section {
    margin: 80px auto;
  }

  .location-switch {
    text-align: center;
    margin-bottom: 30px;
  }

  .location-switch select {
    padding: 10px 18px;
    border-radius: 50px;
    border: 1px solid #ddd;
  }

  .direction-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 30px;
    margin-bottom: 40px;
  }

  .location-card {
    background: linear-gradient(135deg, #fff, #fafafa);
    border-radius: 28px;
    padding: 30px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.06);
  }

  .address {
    color: #555;
    margin-bottom: 20px;
  }

  .cta-row {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
  }

  .contact-box {
    background: #f9fafb;
    padding: 16px;
    border-radius: 16px;
  }

  .map-card {
    border-radius: 24px;
    overflow: hidden;
    min-height: 350px;
  }

  .map-card iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .hours-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 20px;
  }

  .hour-card {
    background: #fff;
    padding: 20px;
    border-radius: 20px;
    text-align: center;
    border: 1px solid #f1f1f1;
    transition: 0.2s;
  }

  .hour-card:hover {
    transform: translateY(-5px);
  }

  .hour-card h4 {
    color: #e60012;
  }

  @media (max-width: 768px) {
    .direction-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<%- include("../partials/footer") %>
