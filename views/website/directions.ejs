<%- include("../partials/header") %>

<section class="container direction-section">
  <h2 class="section-title my-3">Visit Our Showrooms</h2>

  <!-- Location Selector -->
  <div class="location-switch">
    <select id="locationSelect">
      <option value="0">BigWing - Hoodi</option>
      <option value="1">Marathahalli</option>
      <option value="2">Seegehalli</option>
      <option value="3">Gunjur</option>
      <option value="4">Panathur</option>
      <option value="5">Whitefield</option>
      <option value="6">HRBR Layout</option>
    </select>
  </div>

  <!-- Main Grid -->
  <div class="direction-grid">
    <!-- LEFT -->
    <div class="location-card" id="locationCard"></div>

    <!-- RIGHT -->
    <div class="map-card">
      <iframe id="mapFrame"></iframe>
    </div>
  </div>

  <!-- Hours -->
  <div class="hours-grid">
    <div class="hour-card">
      <h4>Sales</h4>
      <p>Mon - Sun</p>
      <span>07:30 AM - 06:30 PM</span>
    </div>
    <div class="hour-card">
      <h4>Service</h4>
      <p>Mon - Sun</p>
      <span>07:30 AM - 06:30 PM</span>
    </div>
    <div class="hour-card">
      <h4>Insurance</h4>
      <p>Mon - Sun</p>
      <span>07:30 AM - 06:30 PM</span>
    </div>
    <div class="hour-card">
      <h4>Finance</h4>
      <p>Mon - Sun</p>
      <span>07:30 AM - 06:30 PM</span>
    </div>
  </div>
</section>

<script>
  const locations = [
    {
      name: "BigWing - Hoodi",
      address:
        "Hoodi Village, ITPL Main Road, Mahadevapura, Bangalore - 560048",
      sales: "7259030091",
      service: "7259586972",
      insurance: "7259030091",
      finance: "7259030091",
