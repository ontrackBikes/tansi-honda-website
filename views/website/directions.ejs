    },
  ];

  let currentIndex = 0;

  const card = document.getElementById("locationCard");
  const map = document.getElementById("mapFrame");

  function renderLocation(index) {
    const loc = locations[index];

    card.innerHTML = `
    <div class="title-row">
      <button id="prevBtn" class="nav-btn"><i class="fa-solid fa-arrow-left"></i></button>
      <h3>${loc.name}</h3>
      <button id="nextBtn" class="nav-btn"><i class="fa-solid fa-arrow-right"></i></button>
    </div>

    <p class="address mt-3">${loc.address}</p>

    <div class="cta-row">
      <a href="tel:${loc.sales}" class="button-custom">
        <i class="fas fa-phone"></i> Call
      </a>
      <a href="https://wa.me/91${loc.sales}" class="outline-btn">
        <i class="fab fa-whatsapp"></i> WhatsApp
      </a>
    </div>

     <div class="contact-box">
       <p><strong>Sales:</strong> ${loc.sales}</p>
       <p><strong>Service:</strong> ${loc.service}</p>
       <p><strong>Insurance:</strong> ${loc.insurance}</p>
       <p><strong>Finance:</strong> ${loc.finance}</p>
       <p><strong>Spares:</strong> ${loc.spares}</p>
     </div>
    `;

    map.src = loc.map;

    // ✅ Attach events AFTER rendering
    document.getElementById("nextBtn").onclick = () => {
      currentIndex = (currentIndex + 1) % locations.length;
      renderLocation(currentIndex);
    };

    document.getElementById("prevBtn").onclick = () => {
      currentIndex = (currentIndex - 1 + locations.length) % locations.length;
      renderLocation(currentIndex);
    };
  }

  // INIT
  renderLocation(currentIndex);
</script>
<style>
  .direction-section {
    margin: 80px auto;
  }

  .outline-btn {
    background: #fff;
    border: 1px solid #121416;
    padding: 10px 22px;
    border-radius: 50px;
    font-weight: 600;
    transition: 0.2s;
    text-decoration: none;
    color: #1e1e2f;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 0.9rem;
  }

  .outline-btn:hover {
    border-color: #25d366;
    color: #25d366;
    transform: translateY(-2px);
  }

  .title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .title-row h3 {
    margin: 0;
    flex: 1;
    text-align: center;
  }

  .nav-btn {
    border: none;
    background: transparent;
    font-size: 20px;
    cursor: pointer;
  }

  .direction-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 30px;
    margin-bottom: 40px;
  }

  .location-card {
    background: linear-gradient(135deg, #fff, #fafafa);
    border-radius: 24px;
    padding: 25px;
    border: 1px solid #eee;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
  }

  .address {
    color: #555;
    margin-bottom: 20px;
  }

  .cta-row {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
  }

  .contact-box {
    background: #f9fafb;
    padding: 15px;
    border-radius: 12px;
  }

  .map-card {
    border-radius: 20px;
    overflow: hidden;
    min-height: 350px;
  }

  .map-card iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .hours-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 20px;
  }

  .hour-card {
    background: #fff;
    padding: 18px;
    border-radius: 16px;
    text-align: center;
    border: 1px solid #eee;
    transition: 0.3s;
  }

  .hour-card:hover {
    transform: translateY(-5px);
  }

  .hour-card h4 {
    color: #e60012;
  }

  @media (max-width: 768px) {
    .direction-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<%- include("../partials/footer") %>
