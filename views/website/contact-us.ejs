<%- include("../partials/header") %>

<section class="insurance-hero text-center py-5 bg-light">
  <div class="container">
    <h1 class="fw-bold">Contact Us</h1>
    <p>
      We’re here to help — reach out for test rides, service,
      <small class="text-danger">or just a friendly chat</small>
    </p>
  </div>
</section>

<div class="container py-4">
  <!-- Hero / intro contact card -->
  <div class="hero-section p-4 p-lg-5 mb-5 shadow-sm rounded-4">
    <div class="row align-items-center g-4">
      <div class="col-md-7">
        <h2 class="fw-bold mb-3">Let’s connect on the road</h2>
        <p class="text-muted lead fs-6">
          Whether you’re looking for a new Honda, need service assistance, or
          just want to know more about our offers — our team is ready to assist
          you. Visit us, call, or drop a message.
        </p>
        <div class="d-flex flex-wrap gap-3 mt-4">
          <div>
            <i class="bi bi-telephone-fill text-danger me-1"></i>
            <span class="fw-semibold">+91 44 4230 1234</span>
          </div>
          <div>
            <i class="bi bi-envelope-fill text-danger me-1"></i>
            <span class="fw-semibold">hello@tansihonda.com</span>
          </div>
          <div>
            <i class="bi bi-whatsapp text-danger me-1"></i>
            <span class="fw-semibold">+91 98765 43210</span>
          </div>
        </div>
      </div>
      <div class="col-md-5 text-center">
        <div class="bg-light-red rounded-4 p-3 d-inline-block shadow-sm">
          <i class="bi bi-chat-dots-fill fs-1 text-danger"></i>
          <h3 class="fw-bold mb-0 mt-2">24/7 Support</h3>
          <p class="small text-muted mb-0">Emergency roadside assistance</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick contact info cards (like stats cards) -->
  <div class="row g-4 mb-5">
    <div class="col-md-4">
      <div class="card border-0 shadow-sm rounded-4 p-3 contact-card h-100">
        <div class="d-flex align-items-center">
          <div class="stats-icon bg-light-red text-danger me-3">
            <i class="bi bi-geo-alt fs-4"></i>
          </div>
          <div>
            <p class="text-muted small mb-0 fw-semibold">Visit Showroom</p>
            <h6 class="fw-bold mb-0">
              No.42, Mount Road, Guindy, Chennai - 600032
            </h6>
            <p class="small text-muted mt-1">
              Open Mon-Sat 9am–8pm, Sun 10am–5pm
            </p>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm rounded-4 p-3 contact-card h-100">
        <div class="d-flex align-items-center">
          <div class="stats-icon bg-light-success text-success me-3">
            <i class="bi bi-telephone-outbound fs-4"></i>
          </div>
          <div>
            <p class="text-muted small mb-0 fw-semibold">Call / WhatsApp</p>
            <h6 class="fw-bold mb-0">Sales: +91 44 4230 1234</h6>
            <h6 class="fw-bold mb-0">Service: +91 44 4230 5678</h6>
            <p class="small text-muted mt-1">Mon-Sat 9am–7pm</p>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm rounded-4 p-3 contact-card h-100">
        <div class="d-flex align-items-center">
          <div class="stats-icon bg-light-primary text-primary me-3">
            <i class="bi bi-envelope-paper fs-4"></i>
          </div>
          <div>
            <p class="text-muted small mb-0 fw-semibold">Email Us</p>
            <h6 class="fw-bold mb-0">hello@tansihonda.com</h6>
            <h6 class="fw-bold mb-0">service@tansihonda.com</h6>
            <p class="small text-muted mt-1">Response within 24 hours</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Contact Form + Map Section -->
  <div class="row g-4 mb-5">
    <div class="col-lg-7">
      <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
        <div class="card-header bg-white border-0 p-4 pb-0">
          <h5 class="fw-bold mb-0">
            <i class="bi bi-envelope me-2 text-danger"></i> Send us a message
          </h5>
          <p class="text-muted small mt-1">
            We’ll get back to you as soon as possible
          </p>
        </div>
        <div class="card-body p-4">
          <form>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label fw-semibold small">Full name</label>
                <input
                  type="text"
                  class="form-control"
                  placeholder="John Doe"
                />
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold small">Phone number</label>
                <input
                  type="tel"
                  class="form-control"
                  placeholder="+91 98765 43210"
                />
              </div>
              <div class="col-12">
                <label class="form-label fw-semibold small"
                  >Email address</label
                >
                <input
                  type="email"
                  class="form-control"
                  placeholder="hello@example.com"
                />
              </div>
              <div class="col-12">
                <label class="form-label fw-semibold small">Subject</label>
                <select class="form-select">
                  <option selected>I'm interested in...</option>
                  <option>New bike purchase / test ride</option>
                  <option>Service appointment</option>
                  <option>Spare parts enquiry</option>
                  <option>Finance / Insurance</option>
                  <option>General feedback</option>
                </select>
              </div>
              <div class="col-12">
                <label class="form-label fw-semibold small">Message</label>
                <textarea
                  class="form-control"
                  rows="4"
                  placeholder="Tell us more about your requirement..."
                ></textarea>
              </div>
              <div class="col-12">
                <button type="submit" class="btn btn-danger btn-lg pill w-100">
                  <i class="bi bi-send me-2"></i>Send Message
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
    <div class="col-lg-5">
      <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
        <iframe
          src="https://www.google.com/maps/d/embed?mid=1TsG7QBzueBxvpfVj2cX-JsI-e5c7nXc&ehbc=2E312F"
          style="border: 0"
          width="640"
          height="600"
          loading="lazy"
        >
        </iframe>
      </div>
    </div>
  </div>

  <!-- Additional service centers & quick links (optional but informative) -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
    <div class="card-header bg-white border-0 p-4 pb-0">
      <h5 class="fw-bold mb-0">
        <i class="bi bi-building me-2 text-danger"></i> Our other service hubs
      </h5>
      <p class="text-muted small">
        Conveniently located across the city for all your Honda needs
      </p>
    </div>
    <div class="card-body p-4">
      <div class="row g-4">
        <div class="col-md-4">
          <div class="d-flex">
            <i class="bi bi-geo-alt-fill text-danger me-3 fs-5"></i>
            <div>
              <h6 class="fw-bold mb-1">Anna Nagar Service Point</h6>
              <p class="small text-muted mb-0">
                No. 17, 2nd Ave, Anna Nagar, Chennai - 600040<br />
                <i class="bi bi-telephone"></i> +91 44 2626 1212
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="d-flex">
            <i class="bi bi-geo-alt-fill text-danger me-3 fs-5"></i>
            <div>
              <h6 class="fw-bold mb-1">OMR – IT Corridor</h6>
              <p class="small text-muted mb-0">
                Sholinganallur, Chennai - 600119<br /><i
                  class="bi bi-telephone"
                ></i>
                +91 44 4747 8888
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="d-flex">
            <i class="bi bi-geo-alt-fill text-danger me-3 fs-5"></i>
            <div>
              <h6 class="fw-bold mb-1">T. Nagar Showroom</h6>
              <p class="small text-muted mb-0">
                Usman Road, T. Nagar, Chennai - 600017<br /><i
                  class="bi bi-telephone"
                ></i>
                +91 44 2815 6789
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- FAQ / Quick connect note (optional) -->
  <div class="row g-4 align-items-stretch">
    <div class="col-md-6">
      <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
        <div class="d-flex align-items-center mb-3">
          <div
            class="stats-icon bg-light-warning text-warning me-3"
            style="width: 48px; height: 48px"
          >
            <i class="bi bi-question-circle fs-5"></i>
          </div>
          <h5 class="fw-bold mb-0">Frequently Asked</h5>
        </div>
        <div class="accordion accordion-flush" id="faqAccordion">
          <div class="accordion-item border-0">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed bg-transparent shadow-none fw-semibold"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#faq1"
              >
                Can I book a test ride online?
              </button>
            </h2>
            <div
              id="faq1"
              class="accordion-collapse collapse"
              data-bs-parent="#faqAccordion"
            >
              <div class="accordion-body text-muted small">
                Absolutely! Fill out the contact form or call our sales team to
                schedule a free home test ride at your convenience.
              </div>
            </div>
          </div>
          <div class="accordion-item border-0">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed bg-transparent shadow-none fw-semibold"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#faq2"
              >
                What documents are needed for service?
              </button>
            </h2>
            <div
              id="faq2"
              class="accordion-collapse collapse"
              data-bs-parent="#faqAccordion"
            >
              <div class="accordion-body text-muted small">
                Just bring your bike’s registration certificate and service
                booklet. Our team will assist you with quick check-in.
              </div>
            </div>
          </div>
          <div class="accordion-item border-0">
            <h2 class="accordion-header">
              <button
                class="accordion-button collapsed bg-transparent shadow-none fw-semibold"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#faq3"
              >
                Do you offer finance & insurance?
              </button>
            </h2>
            <div
              id="faq3"
              class="accordion-collapse collapse"
              data-bs-parent="#faqAccordion"
            >
              <div class="accordion-body text-muted small">
                Yes! We partner with leading banks to provide flexible EMI
                options and comprehensive insurance coverage.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card border-0 shadow-sm rounded-4 p-4 h-100 text-center">
        <i class="bi bi-chat-heart fs-1 text-danger mb-3"></i>
        <h5 class="fw-bold">Connect with us on social</h5>
        <p class="text-muted small">
          Follow for latest offers, new launches, and riding events.
        </p>
        <div class="d-flex justify-content-center gap-4 mt-2">
          <a href="#" class="text-danger fs-4"
            ><i class="bi bi-instagram"></i
          ></a>
          <a href="#" class="text-danger fs-4"
            ><i class="bi bi-facebook"></i
          ></a>
          <a href="#" class="text-danger fs-4"><i class="bi bi-youtube"></i></a>
          <a href="#" class="text-danger fs-4"
            ><i class="bi bi-whatsapp"></i
          ></a>
        </div>
        <hr class="my-3" />
        <p class="small text-muted mb-0">
          <i class="bi bi-envelope-paper-fill text-danger"></i> For corporate /
          bulk enquiries: corporate@tansihonda.com
        </p>
      </div>
    </div>
  </div>
</div>

<style>
  * {
    font-family: "Inter", sans-serif;
  }
  body {
    background-color: #f8f9fa;
  }

  /* Custom color utilities (matching dashboard & about page) */
  .bg-light-red {
    background-color: rgba(230, 0, 18, 0.1);
  }
  .bg-light-success {
    background-color: rgba(25, 135, 84, 0.1);
  }
  .bg-light-warning {
    background-color: rgba(255, 193, 7, 0.1);
  }
  .bg-light-primary {
    background-color: rgba(13, 110, 253, 0.1);
  }
  .bg-light-secondary {
    background-color: rgba(108, 117, 125, 0.1);
  }

  .stats-icon {
    width: 54px;
    height: 54px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    transition: all 0.2s ease;
  }

  .info-card,
  .contact-card {
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .info-card:hover,
  .contact-card:hover {
    transform: translateY(-5px);
  }

  .badge-soft-red {
    background-color: rgba(230, 0, 18, 0.12);
    color: #e60012;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 40px;
    font-size: 0.8rem;
  }

  .hero-section {
    background: linear-gradient(135deg, #ffffff 0%, #fef2f2 100%);
    border-radius: 28px;
    border: 1px solid #e600133e;
  }

  .section-title {
    position: relative;
    display: inline-block;
  }
  .section-title:after {
    content: "";
    position: absolute;
    bottom: -10px;
    left: 0;
    width: 60px;
    height: 3px;
    background: #e60012;
    border-radius: 4px;
  }

  /* Form styling */
  .form-control,
  .form-select {
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    padding: 12px 16px;
    font-size: 0.95rem;
    transition: all 0.2s;
  }
  .form-control:focus,
  .form-select:focus {
    border-color: #e60012;
    box-shadow: 0 0 0 3px rgba(230, 0, 18, 0.1);
  }
</style>

<script></script>

<%- include("../partials/footer") %>
