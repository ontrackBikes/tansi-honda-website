<%- include("../partials/header") %>

<section class="insurance-hero text-center py-5 bg-light">
  <div class="container">
    <h1 class="fw-bold">Contact Us</h1>
    <p>
      We’re here to help — reach out for test rides, service,
      <span class="text-danger">or just a friendly chat</span>
    </p>
  </div>
</section>

<div class="container py-4">
  <!-- Contact Form + Map Section -->
  <div class="row g-4 mb-5">
    <div class="col-lg-7">
      <div class="card border-1 shadow-sm rounded-4 overflow-hidden h-100">
        <div class="card-header bg-white border-1 p-4 pb-0">
          <h3 class="card-title fw-bold mb-1">Send us a message</h3>
          <p class="text-muted small">
            We’ll get back to you as soon as possible
          </p>
        </div>
        <div class="card-body p-4">
          <form>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label fw-semibold small">Full name</label>
                <input
                  type="text"
                  class="form-control"
                  placeholder="Enter your full name"
                />
              </div>
              <div class="col-md-6">
                <label class="form-label fw-semibold small">Phone number</label>
                <input
                  type="tel"
                  class="form-control"
                  placeholder="Enter your phone number"
                />
              </div>
              <div class="col-12">
                <label class="form-label fw-semibold small"
                  >Email address</label
                >
                <input
                  type="email"
                  class="form-control"
                  placeholder="Enter your email address"
                />
              </div>
              <div class="col-12">
                <label class="form-label fw-semibold small">Subject</label>
                <select class="form-select">
                  <option selected disabled>I'm interested in...</option>
                  <option>New bike purchase / test ride</option>
                  <option>Service appointment</option>
                  <option>Spare parts enquiry</option>
                  <option>Finance / Insurance</option>
                  <option>General feedback</option>
                </select>
              </div>
              <div class="col-12">
                <label class="form-label fw-semibold small">Message</label>
                <textarea
                  class="form-control"
                  rows="4"
                  placeholder="Tell us more about your requirement..."
                ></textarea>
              </div>
              <div class="col-12">
                <button type="submit" class="btn btn-danger btn-lg pill w-100">
                  <i class="bi bi-send me-2"></i>Send Message
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
    <div class="col-lg-5">
      <div class="card border-1 shadow-sm rounded-4 p-4 text-center">
        <i class="bi bi-chat-heart fs-1 text-danger mb-3"></i>
        <h5 class="fw-bold">Connect with us on social</h5>
        <p class="text-muted small">
          Follow for latest offers, new launches, and riding events.
        </p>
