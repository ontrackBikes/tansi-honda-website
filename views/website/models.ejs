<%- include("../partials/header") %>

<!-- HERO SECTION -->
<section class="catalog-hero text-center py-5 bg-light">
  <div class="container">
    <h1 class="display-4 fw-bold text-dark">Explore the Complete Honda Lineup</h1>
    <p class="lead text-muted mt-3">From sporty scooters to legendary Gold Wing · Discover your perfect ride at Tansi Honda, Bangalore</p>
  </div>
</section>

<!-- MAIN CONTENT -->
<div class="container my-5">

  <!-- CATEGORY FILTER -->
 <div class="text-center mb-4">
  <a href="/models" class="btn btn-sm me-2 <%= currentCategory==='All' ? 'btn-dark' : 'btn-outline-dark' %>">All</a>
  <a href="/motorcycle" class="btn btn-sm me-2 <%= currentCategory==='motorcycle' ? 'btn-dark' : 'btn-outline-dark' %>">Motorcycles</a>
  <a href="/scooter" class="btn btn-sm me-2 <%= currentCategory==='scooter' ? 'btn-dark' : 'btn-outline-dark' %>">Scooters</a>
  <a href="/e2w" class="btn btn-sm <%= currentCategory==='e2w' ? 'btn-dark' : 'btn-outline-dark' %>">EV</a>
</div>

  <!-- SEARCH BAR -->
  <div class="row justify-content-center mb-5">
  <div class="col-md-6 col-lg-5">
    <div class="search-container">
      <i class="fas fa-search search-icon"></i>
      <input type="text" id="searchInput" class="search-input" placeholder="Explore models..." autocomplete="off">
      <button id="clearSearch" class="clear-btn">&times;</button>
    </div>
    <p class="text-muted mt-3 text-center small fw-light" id="resultCount"></p>
  </div>
</div>

  <!-- MODELS GRID -->
  <div class="row g-4" id="modelsContainer">
    <% if (!models.length) { %>
      <div class="col-12 text-center py-5">
        <h5 class="text-muted">🚫 No models available</h5>
      </div>
    <% } else { %>
      <% models.forEach(model => { %>
        <div class="col-6 col-md-4 col-lg-3">
          <a href="/<%= model.category %>/<%= model.slug %>" class="text-decoration-none">
            <div class="card h-100 border-0 shadow-sm hover-shadow rounded-4 overflow-hidden">
              <img src="<%= model.coverImage || '/images/default-bike.jpg' %>" class="card-img-top" alt="<%= model.name %>" style="height:200px; object-fit:cover;">
              <div class="card-body text-center py-3">
                <h5 class="card-title text-danger fw-bold mb-0"><%= model.name %></h5>
                <p class="text-muted small mb-0 text-capitalize"><%= model.category %></p>
              </div>
            </div>
          </a>
        </div>
      <% }) %>
    <% } %>
  </div>

</div>

<!-- STYLES -->
<style>
.catalog-hero {
  background: linear-gradient(135deg,#fef9f5 0%,#ffffff 100%);
}

.hover-shadow:hover {
  transform: translateY(-5px);
  transition: 0.3s ease;
  box-shadow: 0 15px 35px rgba(0,0,0,0.12) !important;
}

.input-group input::placeholder {
  color: #adb5bd;
  font-style: italic;
}

.card-title {
  font-size: 1.1rem;
}

.card-body p {
  font-size: 0.85rem;
}

.btn-sm {
  padding: 0.35rem 0.75rem;
  border-radius: 50px;
  font-weight: 500;
}

.search-container {
    position: relative;
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(220, 53, 69, 0.2);
    padding: 8px 20px;
    border-radius: 50px;
    transition: all 0.3s ease;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
  }

  .search-icon {
    color: #dc3545;
    font-size: 1.1rem;
    margin-right: 12px;
  }

  .search-input {
    border: none;
    background: transparent;
    width: 100%;
    outline: none;
    font-size: 1rem;
    color: #333;
    padding: 8px 0;
  }

  .clear-btn {
    border: none;
    background: none;
    color: #bbb;
    font-size: 1.2rem;
    cursor: pointer;
    transition: color 0.2s;
  }

  .clear-btn:hover {
    color: #dc3545;
  }
</style>

<!-- SEARCH SCRIPT -->
<script>
const searchInput = document.getElementById("searchInput");
const clearBtn = document.getElementById("clearSearch");
const cards = document.querySelectorAll(".card.h-100");
const resultCount = document.getElementById("resultCount");

function updateResultsCount() {
  const visibleCards = [...cards].filter(card => card.closest('a').style.display !== "none");
  resultCount.textContent = `${visibleCards.length} result(s) found`;
}

searchInput.addEventListener("keyup", () => {
  const val = searchInput.value.toLowerCase();
  cards.forEach(card => {
    const text = card.innerText.toLowerCase();
    card.closest('a').style.display = text.includes(val) ? "" : "none";
  });
  updateResultsCount();
});

clearBtn.addEventListener("click", () => {
  searchInput.value = "";
  cards.forEach(card => card.closest('a').style.display = "");
  resultCount.textContent = "";
});

updateResultsCount();
</script>

<%- include("../partials/footer") %>