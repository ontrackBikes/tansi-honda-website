<%- include("../partials/header") %>

<div class="container vehicle-detail py-5">

  <div class="row align-items-center g-3 mb-4">
    <div class="col-md-7">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2">
          <li class="breadcrumb-item small text-uppercase fw-bold text-danger"><%= model.category %></li>
          <li class="breadcrumb-item small text-uppercase fw-bold text-muted"><%= model.subCategory %></li>
        </ol>
      </nav>
      <h1 class="vehicle-title text-dark"><%= model.name %></h1>
    </div>

    <div class="col-md-5 text-md-end">
        <% if (model.brochure) { %>
          <a href="<%= model.brochure %>" target="_blank" class="btn btn-outline-dark rounded-pill px-4 fw-bold">
            📄 Download Brochure
          </a>
        <% } %>
        <button class="btn btn-danger rounded-pill px-4 fw-bold ms-2" onclick="openEnquiry()">
          💬 Get Quote
        </button>
    </div>
  </div>

  <div class="row g-5">
    
    <div class="col-lg-7">
      <div class="main-vehicle-img">
        <img 
          id="activeVehicleImage"
          src="<%= model.coverImage || '/images/default-bike.jpg' %>" 
          alt="<%= model.name %>" 
          class="img-fluid transition-img"
        >
      </div>
      
      <% if (model.colors && model.colors.length > 0) { %>
        <div class="mt-4 text-center">
          <p class="small fw-bold text-muted text-uppercase mb-3">Available Colors</p>
          <div class="d-flex justify-content-center gap-3">
            <% model.colors.forEach((color, index) => { %>
              <div 
                class="color-circle shadow-sm <%= index === 0 ? 'active-color' : '' %>" 
                style="background-color: <%= color.code %>;"
                title="<%= color.name %>"
                onclick="changeVehicleColor('<%= color.image %>', this)"
              ></div>
            <% }) %>
          </div>
          <p id="colorNameDisplay" class="small mt-2 fw-bold text-dark"><%= model.colors[0].name %></p>
        </div>
      <% } %>
    </div>

    <div class="col-lg-5">
      <div class="ps-lg-4">
        <div class="badge bg-danger mb-3">New Launch</div>
        <h4 class="fw-bold">Model Overview</h4>
        <p class="text-muted leading-relaxed">
          <%= model.description %>
        </p>

        <div class="row mt-4 g-3">
          <div class="col-6">
            <div class="p-3 border rounded-4 text-center h-100">
              <span class="fs-3">🛡️</span>
              <p class="small fw-bold mb-0 mt-1">Safety First</p>
              <span class="text-muted extra-small">Advanced Braking</span>
            </div>
          </div>
          <div class="col-6">
            <div class="p-3 border rounded-4 text-center h-100">
              <span class="fs-3">⛽</span>
              <p class="small fw-bold mb-0 mt-1">Efficiency</p>
              <span class="text-muted extra-small">Best-in-class mileage</span>
            </div>
          </div>
        </div>

        <div class="mt-5 d-grid gap-2">
            <button class="btn btn-dark btn-lg rounded-4 fw-bold py-3" onclick="openEnquiry()">
                BOOK A TEST RIDE
            </button>
            <a href="https://wa.me/919XXXXXXXXX?text=I'm interested in <%= model.name %>" target="_blank" class="btn btn-outline-success btn-lg rounded-4 fw-bold py-3">
                Chat on WhatsApp
            </a>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-5 pt-5">
    <ul class="nav nav-pills mb-4 justify-content-center" id="vehicleTab" role="tablist">
        <li class="nav-item">
          <button class="nav-link active fw-bold px-4" data-bs-toggle="tab" data-bs-target="#specs">Specifications</button>
        </li>
        <li class="nav-item">
          <button class="nav-link fw-bold px-4" data-bs-toggle="tab" data-bs-target="#variants">Variants</button>
        </li>
    </ul>

    <div class="tab-content border-top pt-4">
        <div class="tab-pane fade show active" id="specs">
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <div class="table-responsive rounded-4 shadow-sm">
                        <table class="table table-striped align-middle mb-0">
                            <tbody class="border-0">
                                <tr>
                                    <td class="ps-4 py-3 text-muted">Category</td>
                                    <td class="text-end pe-4 fw-bold"><%= model.category %></td>
                                </tr>
                                <tr>
                                    <td class="ps-4 py-3 text-muted">Sub Category</td>
                                    <td class="text-end pe-4 fw-bold"><%= model.subCategory %></td>
                                </tr>
                                <tr>
                                    <td class="ps-4 py-3 text-muted">Status</td>
                                    <td class="text-end pe-4 fw-bold">
                                        <span class="text-success">● Active</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="variants">
            <div class="row g-3">
                <% model.variants.forEach(variant => { %>
                    <div class="col-md-6">
                        <div class="p-4 border rounded-4 bg-white d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="fw-bold mb-1"><%= variant.name %></h5>
                                <span class="badge bg-light text-dark border">SKU: <%= variant.sku %></span>
                            </div>
                            <button class="btn btn-outline-danger btn-sm rounded-pill px-3">View Details</button>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>
  </div>
</div>

<div class="modal fade" id="enquiryModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 rounded-4 shadow">
      <div class="modal-header border-0 pb-0">
        <h5 class="fw-bold">Book an Appointment</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-4">
        <form>
            <div class="mb-3">
                <label class="form-label small fw-bold">Interested in:</label>
                <input type="text" class="form-control bg-light border-0" value="<%= model.name %>" readonly>
            </div>
            <div class="mb-3">
                <input type="text" class="form-control border-0 bg-light p-3" placeholder="Your Name">
            </div>
            <div class="mb-3">
                <input type="tel" class="form-control border-0 bg-light p-3" placeholder="Phone Number">
            </div>
            <button class="btn btn-danger w-100 py-3 fw-bold rounded-4 shadow-sm">Submit Enquiry</button>
        </form>
      </div>
    </div>
  </div>
</div>

<style>
  .vehicle-title { font-size: 3rem; font-weight: 900; letter-spacing: -1px; }
  .main-vehicle-img { background: radial-gradient(#fff, #f4f6f9); border-radius: 40px; padding: 40px; position: relative; }
  .transition-img { transition: all 0.4s ease-in-out; }
  
  /* Color Circle Styling */
  .color-circle {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    cursor: pointer;
    border: 3px solid white;
    outline: 1px solid #ddd;
    transition: 0.2s;
  }
  .color-circle:hover { transform: scale(1.2); }
  .active-color { outline: 2px solid #e60012; transform: scale(1.1); }

  .extra-small { font-size: 0.7rem; }
  .nav-pills .nav-link { color: #666; border-radius: 12px; }
  .nav-pills .nav-link.active { background-color: #e60012; color: white; }
  .leading-relaxed { line-height: 1.8; }
</style>

<script>
function changeVehicleColor(imgSrc, element) {
  // Update main image
  const mainImg = document.getElementById('activeVehicleImage');
  mainImg.style.opacity = '0';
  setTimeout(() => {
    mainImg.src = imgSrc;
    mainImg.style.opacity = '1';
  }, 200);

  // Update swatches
  document.querySelectorAll('.color-circle').forEach(c => c.classList.remove('active-color'));
  element.classList.add('active-color');

  // Update color name text
  document.getElementById('colorNameDisplay').innerText = element.title;
}

function openEnquiry() {
  new bootstrap.Modal(document.getElementById('enquiryModal')).show();
}
</script>

<%- include("../partials/footer") %>