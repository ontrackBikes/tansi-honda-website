<%- include("../partials/header") %>

  <section class="insurance-hero text-center py-5 bg-light">
    <div class="container">
      <h1 class="fw-bold">Special Offers</h1>
      <p>
        Unlock exclusive savings, exchange bonuses, and festive deals on
        <span class="text-danger">Honda two-wheelers</span>
      </p>
    </div>
  </section>

  <div class="container py-4">
    <!-- Hero banner with main offer -->
    <div class="hero-section p-4 p-lg-5 mb-5 shadow-sm rounded-4 position-relative overflow-hidden">
      <div class="row align-items-center g-4">
        <div class="col-md-8">
          <span class="badge bg-danger text-white px-3 py-2 mb-3 rounded-pill">🔥 Hot Deal of the Month</span>
          <h2 class="fw-bold display-5">Up to ₹14,000 Cashback</h2>
          <p class="lead fs-5">
            On selected Honda Activa, Honda Dio and Honda CB 125 Hornet
          </p>
          <div class="d-flex flex-wrap gap-3 mt-4">
            <div>
              <i class="bi bi-check-circle-fill text-danger me-1"></i> Honda Activa
            </div>
            <div>
              <i class="bi bi-check-circle-fill text-danger me-1"></i> Honda Dio
            </div>
            <div>
              <i class="bi bi-check-circle-fill text-danger me-1"></i> Honda CB 125 Hornet
            </div>
          </div>
          <a href="#currentOffers" class="btn btn-danger mt-4 px-5 py-2 rounded-pill fw-semibold">
            Grab Offer <i class="bi bi-arrow-right"></i>
          </a>
        </div>
        <div class="col-md-4 text-center">
          <div class="bg-light-red rounded-4 p-3 d-inline-block shadow-sm">
            <img src="/images/banners/special-discount.jpeg" alt="Special Discount" loading="eager" height="200"
              width="200" />
          </div>
        </div>
      </div>
    </div>

    <!-- Stats / highlight cards (like dashboard) -->
    <div class="row g-4 mb-5">
      <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-4 p-3 stats-card h-100">
          <div class="d-flex align-items-center">
            <div class="stats-icon bg-light-red text-danger me-3">
              <i class="bi bi-percent fs-4"></i>
            </div>
            <div>
              <p class="text-muted small mb-0 fw-semibold">Instant Discount</p>
              <h5 class="fw-bold mb-0">Up to ₹5,000</h5>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-4 p-3 stats-card h-100">
          <div class="d-flex align-items-center">
            <div class="stats-icon bg-light-success text-success me-3">
              <i class="bi bi-arrow-repeat fs-4"></i>
            </div>
            <div>
              <p class="text-muted small mb-0 fw-semibold">Exchange Bonus</p>
              <h5 class="fw-bold mb-0">₹2,000</h5>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-4 p-3 stats-card h-100">
          <div class="d-flex align-items-center">
            <div class="stats-icon bg-light-warning text-warning me-3">
              <i class="bi bi-credit-card fs-4"></i>
            </div>
            <div>
              <p class="text-muted small mb-0 fw-semibold">Corporate Offer</p>
              <h5 class="fw-bold mb-0">₹2,000</h5>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm rounded-4 p-3 stats-card h-100">
          <div class="d-flex align-items-center">
            <div class="stats-icon bg-light-primary text-primary me-3">
              <i class="bi bi-gift fs-4"></i>
            </div>
            <div>
              <p class="text-muted small mb-0 fw-semibold">Credit Card EMI</p>
              <h5 class="fw-bold mb-0"> ₹5,000 Cashback</h5>
            </div>
          </div>
        </div>
      </div>
    </div>


    <!-- Offer Cards Grid -->
    <div class="mb-5" id="currentOffers">
      <div class="d-flex align-items-center justify-content-between align-items-end mb-4 flex-wrap">
        <h3 class="fw-bold section-title">Current Offers</h3>

        <a href="/models" class="text-danger text-decoration-none small fw-semibold">View all models <i
            class="bi bi-arrow-right"></i></a>
      </div>
      <div class="row g-4" id="modelsContainer">
        <% 
          // Custom JSON array bypassing the database/model data entirely
          const promotionalModels = [
            {
              "name": "Honda Activa 110",
              "slug": "honda-activa-110",
              "category": "scooter",
              "coverImage": "/images/scooter/honda-activa-110/5.png",
              "description": "The Honda Activa 110 (Activa 6G) continues its legacy as India's favorite family scooter. Now upgraded with H-Smart technology, it features a fuel-efficient 110cc PGM-FI engine, telescopic suspension, and advanced smart key features for ultimate convenience and reliability."
            },
            {
              "name": "Honda Dio 110",
              "slug": "honda-dio-110",
              "category": "scooter",
              "coverImage": "/images/scooter/honda-dio-110/1.png",
              "description": "The Honda Dio 110 stands out as a sporty and stylish scooter designed for young riders seeking performance and everyday convenience. Powered by a fuel-efficient 110cc engine with Honda’s advanced technology, it offers smooth acceleration and agile handling. With its bold design, lightweight build, and practical features, the Dio 110 delivers a fun and comfortable riding experience for city commutes."
            },
            {
              "name": "Honda Activa 125",
              "slug": "honda-activa-125",
              "category": "scooter",
              "coverImage": "/images/scooter/honda-activa-125/1.png",
              "description": "The Honda Activa 125 (Activa 6G) continues its legacy as India's favorite family scooter. Now upgraded with H-Smart technology, it features a fuel-efficient 125cc PGM-FI engine, telescopic suspension, and advanced smart key features for ultimate convenience and reliability."
            },
            {
              "name": "Honda CB125 Hornet",
              "slug": "honda-cb125-hornet",
              "category": "motorcycle",
              "coverImage": "https://edge.sitecorecloud.io/hondamotorc388f-hmsi8ece-prodb777-e813/media/Project/HONDA2WI/honda2wheelersindia/motorcycle/CB-125/nav/CB125.jpg?h=240&iar=0&w=360",
              "description": "A premium 125cc streetfighter motorcycle with aggressive styling, advanced TFT connectivity, USD suspension, and refined Honda performance. Designed for young riders seeking sporty looks, comfort, and modern technology."
            }
          ];
        %>

          <% promotionalModels.forEach(model=> { %>
            <div class="col-6 col-md-4 col-lg-3">
              <a href="/<%= model.category %>/<%= model.slug %>" class="text-decoration-none text-dark">

                <div class="card h-100 border-0 shadow-sm rounded-4 hover-shadow">

                  <div class="p-3">
                    <img src="<%= model.coverImage %>" alt="<%= model.name %>" class="img-fluid"
                      style="height: 180px; object-fit: contain;">
                  </div>

                  <div class="card-body pt-0">
                    <h5 class="fw-bold text-black mb-2">
                      <%= model.name %>
                    </h5>

                    <p class="text-muted small text-capitalize mb-2" style="
                     display: -webkit-box;
                     -webkit-line-clamp: 2;
                     -webkit-box-orient: vertical;
                      overflow: hidden;
                    ">
                      <%= model.description %>
                    </p>

                    <span class="text-danger fw-semibold">
                      Explore <i class="fas fa-arrow-right ms-1"></i>
                    </span>
                  </div>

                </div>

              </a>
            </div>
            <% }) %>
      </div>
    </div>

    <!-- Finance & Exchange Banner -->
    <div class="row g-4 mb-5">
      <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-light-red bg-opacity-10">
          <div class="d-flex align-items-center mb-3">
            <div class="stats-icon bg-light-danger text-danger me-3" style="background: rgba(230, 0, 18, 0.2)">
              <i class="bi bi-currency-rupee fs-4"></i>
            </div>
            <h5 class="fw-bold mb-0">Easy Finance Options</h5>
          </div>

          <p class="text-muted">
            Get easy financing options with minimal documentation and quick processing at the dealership.
          </p>

          <ul class="list-unstyled small">
            <li>
              <i class="bi bi-check-circle-fill text-danger me-2"></i>
              Upto 95% on-road funding
            </li>

            <li>
              <i class="bi bi-check-circle-fill text-danger me-2"></i>
              Flexible tenure upto 60 months
            </li>

            <li>
              <i class="bi bi-check-circle-fill text-danger me-2"></i>
              Instant Approval at Dealership
            </li>
          </ul>

          <!-- <a href="#" class="btn btn-outline-danger mt-2 align-self-start rounded-pill px-4">
        Check Eligibility
      </a> -->
        </div>
      </div>

      <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-light-success bg-opacity-10">
          <div class="d-flex align-items-center mb-3">
            <div class="stats-icon bg-light-success text-success me-3">
              <i class="bi bi-arrow-left-right fs-4"></i>
            </div>
            <h5 class="fw-bold mb-0">Exchange Bonus</h5>
          </div>

          <p class="text-muted">
            Upgrade to a new Honda and get an additional exchange bonus of ₹4000.
          </p>

          <div class="mt-2">
            <div class="d-flex justify-content-between small fw-semibold">
              <span>Red Wing</span>
              <span>Upto ₹2000</span>
            </div>

            <div class="d-flex justify-content-between small fw-semibold mt-1">
              <span>Big Wing</span>
              <span>Upto ₹4000</span>
            </div>
          </div>

          <!-- <a href="#" class="btn btn-outline-danger mt-3 align-self-start rounded-pill px-4">
        Get Valuation
      </a> -->
        </div>
      </div>
    </div>
  </div>

  <style>
    /* Custom color utilities (consistent with dashboard) */
    .bg-light-red {
      background-color: rgba(230, 0, 18, 0.1);
    }

    .bg-light-success {
      background-color: rgba(25, 135, 84, 0.1);
    }

    .bg-light-warning {
      background-color: rgba(255, 193, 7, 0.1);
    }

    .bg-light-primary {
      background-color: rgba(13, 110, 253, 0.1);
    }

    .bg-light-secondary {
      background-color: rgba(108, 117, 125, 0.1);
    }

    .stats-icon {
      width: 54px;
      height: 54px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 16px;
      transition: all 0.2s ease;
    }

    .offer-card,
    .stats-card {
      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
    }

    .offer-card:hover,
    .stats-card:hover {
      transform: translateY(-5px);
    }

    .badge-soft-red {
      background-color: rgba(230, 0, 18, 0.12);
      color: #e60012;
      font-weight: 600;
      padding: 8px 16px;
      border-radius: 40px;
      font-size: 0.8rem;
    }

    .hero-section {
      background: linear-gradient(135deg, #ffffff 0%, #fef2f2 100%);
      border-radius: 28px;
      border: 1px solid #e600133e;
    }

    .section-title {
      position: relative;
      display: inline-block;
    }

    .offer-badge {
      position: absolute;
      top: 20px;
      right: 20px;
      background: #e60012;
      color: white;
      padding: 6px 14px;
      border-radius: 40px;
      font-weight: 600;
      font-size: 0.75rem;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
      z-index: 2;
    }

    .offer-img {
      height: 200px;
      object-fit: cover;
      border-top-left-radius: 16px;
      border-top-right-radius: 16px;
    }

    .countdown {
      font-weight: 700;
      background: #f1f3f5;
      display: inline-block;
      padding: 4px 12px;
      border-radius: 40px;
      font-size: 0.85rem;
    }
  </style>

  <script></script>

  <%- include("../partials/footer") %>