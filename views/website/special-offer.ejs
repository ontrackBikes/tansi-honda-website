<%- include("../partials/header") %>

<section class="insurance-hero text-center py-5 bg-light">
  <div class="container">
    <h1 class="fw-bold">Special Offers</h1>
    <p>
      Unlock exclusive savings, exchange bonuses, and festive deals on
      <span class="text-danger">Honda two-wheelers</span>
    </p>
  </div>
</section>

<div class="container py-4">
  <!-- Hero banner with main offer -->
  <div
    class="hero-section p-4 p-lg-5 mb-5 shadow-sm rounded-4 position-relative overflow-hidden"
  >
    <div class="row align-items-center g-4">
      <div class="col-md-8">
        <span class="badge bg-danger text-white px-3 py-2 mb-3 rounded-pill"
          >🔥 Hot Deal of the Month</span
        >
        <h2 class="fw-bold display-5">Up to ₹15,000 Cashback</h2>
        <p class="lead fs-5">
          On select Honda 125cc & 160cc models. Plus free helmet + extended
          warranty!
        </p>
        <div class="d-flex flex-wrap gap-3 mt-4">
          <div>
            <i class="bi bi-check-circle-fill text-danger me-1"></i> H’ness
            CB350
          </div>
          <div>
            <i class="bi bi-check-circle-fill text-danger me-1"></i> SP 125
          </div>
          <div>
            <i class="bi bi-check-circle-fill text-danger me-1"></i> Hornet 2.0
          </div>
        </div>
        <a
          href="#"
          class="btn btn-danger mt-4 px-5 py-2 rounded-pill fw-semibold"
          >Grab Offer <i class="bi bi-arrow-right"></i
        ></a>
      </div>
      <div class="col-md-4 text-center">
        <div class="bg-light-red rounded-4 p-3 d-inline-block shadow-sm">
          <img
            src="/images/homepage/special_discount.jpg"
            alt="Special Discount"
            loading="eager"
            height="200"
            width="200"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Stats / highlight cards (like dashboard) -->
  <div class="row g-4 mb-5">
    <div class="col-md-3 col-sm-6">
      <div class="card border-0 shadow-sm rounded-4 p-3 stats-card h-100">
        <div class="d-flex align-items-center">
          <div class="stats-icon bg-light-red text-danger me-3">
            <i class="bi bi-percent fs-4"></i>
          </div>
          <div>
            <p class="text-muted small mb-0 fw-semibold">Instant Discount</p>
            <h3 class="fw-bold mb-0">Up to ₹12K</h3>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="card border-0 shadow-sm rounded-4 p-3 stats-card h-100">
        <div class="d-flex align-items-center">
          <div class="stats-icon bg-light-success text-success me-3">
            <i class="bi bi-arrow-repeat fs-4"></i>
          </div>
          <div>
            <p class="text-muted small mb-0 fw-semibold">Exchange Bonus</p>
            <h3 class="fw-bold mb-0">₹5,000</h3>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="card border-0 shadow-sm rounded-4 p-3 stats-card h-100">
        <div class="d-flex align-items-center">
          <div class="stats-icon bg-light-warning text-warning me-3">
            <i class="bi bi-credit-card fs-4"></i>
          </div>
          <div>
            <p class="text-muted small mb-0 fw-semibold">Lowest EMI</p>
            <h3 class="fw-bold mb-0">₹1,999/mo*</h3>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="card border-0 shadow-sm rounded-4 p-3 stats-card h-100">
        <div class="d-flex align-items-center">
          <div class="stats-icon bg-light-primary text-primary me-3">
            <i class="bi bi-gift fs-4"></i>
          </div>
          <div>
            <p class="text-muted small mb-0 fw-semibold">Free Accessories</p>
            <h3 class="fw-bold mb-0">Worth ₹3,000</h3>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Offer Cards Grid -->
  <div class="mb-5">
    <div
      class="d-flex align-items-center justify-content-between align-items-end mb-4 flex-wrap"
    >
      <h3 class="fw-bold section-title">Current Offers</h3>

      <a href="#" class="text-danger text-decoration-none small fw-semibold"
        >View all models <i class="bi bi-arrow-right"></i
      ></a>
    </div>
    <div class="row g-4">
      <!-- Offer 1 -->
      <div class="col-md-6 col-lg-4">
        <div
          class="card border-0 shadow-sm rounded-4 overflow-hidden offer-card h-100 position-relative"
        >
          <div class="offer-badge">Limited Time</div>
          <img
            src="https://placehold.co/600x400/f8f9fa/e60012?text=Honda+CB350"
            class="offer-img w-100"
            alt="Honda CB350"
          />
          <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h5 class="fw-bold mb-0">H’ness CB350</h5>
              <span class="badge bg-light-red text-danger rounded-pill"
                >Save ₹10,000</span
              >
            </div>
            <p class="text-muted small">
              Cashback + free accessories + 3 free services
            </p>
            <div class="d-flex justify-content-between align-items-center mt-3">
              <div class="countdown">
                <i class="bi bi-hourglass-split me-1"></i> Ends in 12 days
              </div>
              <a href="#" class="btn btn-sm btn-danger rounded-pill px-3"
                >Claim</a
              >
            </div>
          </div>
        </div>
      </div>
      <!-- Offer 2 -->
      <div class="col-md-6 col-lg-4">
        <div
          class="card border-0 shadow-sm rounded-4 overflow-hidden offer-card h-100 position-relative"
        >
          <div class="offer-badge" style="background: #198754">
            Exchange Bonus
          </div>
          <img
            src="https://placehold.co/600x400/f8f9fa/e60012?text=Honda+SP125"
            class="offer-img w-100"
            alt="Honda SP125"
          />
          <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h5 class="fw-bold mb-0">SP 125</h5>
              <span class="badge bg-light-success text-success rounded-pill"
                >Exchange ₹5K</span
              >
            </div>
            <p class="text-muted small">
              Exchange any old scooter/bike & get extra ₹5,000 off
            </p>
            <div class="d-flex justify-content-between align-items-center mt-3">
              <div class="countdown">
                <i class="bi bi-calendar-check me-1"></i> Valid till May 15
              </div>
              <a href="#" class="btn btn-sm btn-danger rounded-pill px-3"
                >Get Quote</a
              >
            </div>
          </div>
        </div>
      </div>
      <!-- Offer 3 -->
      <div class="col-md-6 col-lg-4">
        <div
          class="card border-0 shadow-sm rounded-4 overflow-hidden offer-card h-100 position-relative"
        >
          <div class="offer-badge" style="background: #fd7e14">
            Zero Down EMI
          </div>
          <img
            src="https://placehold.co/600x400/f8f9fa/e60012?text=Honda+Hornet+2.0"
            class="offer-img w-100"
            alt="Honda Hornet"
          />
          <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h5 class="fw-bold mb-0">Hornet 2.0</h5>
              <span class="badge bg-light-warning text-warning rounded-pill"
                >EMI from ₹2,499</span
              >
            </div>
            <p class="text-muted small">
              Zero down payment, flexible tenure up to 36 months
            </p>
            <div class="d-flex justify-content-between align-items-center mt-3">
              <div class="countdown">
                <i class="bi bi-calculator me-1"></i> Limited units
              </div>
              <a href="#" class="btn btn-sm btn-danger rounded-pill px-3"
                >Apply Now</a
              >
            </div>
          </div>
        </div>
      </div>
      <!-- Offer 4 -->
      <div class="col-md-6 col-lg-4">
        <div
          class="card border-0 shadow-sm rounded-4 overflow-hidden offer-card h-100 position-relative"
        >
          <div class="offer-badge">Festival Flash</div>
          <img
            src="https://placehold.co/600x400/f8f9fa/e60012?text=Honda+Activa"
            class="offer-img w-100"
            alt="Honda Activa"
          />
          <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h5 class="fw-bold mb-0">Activa 6G & Deluxe</h5>
              <span class="badge bg-light-red text-danger rounded-pill"
                >₹7,000 off</span
              >
            </div>
            <p class="text-muted small">
              Complimentary extended warranty + RSA for 1 year
            </p>
            <div class="d-flex justify-content-between align-items-center mt-3">
              <div class="countdown">
                <i class="bi bi-fire me-1"></i> Ends in 5 days
              </div>
              <a href="#" class="btn btn-sm btn-danger rounded-pill px-3"
                >Book Now</a
              >
            </div>
          </div>
        </div>
      </div>
      <!-- Offer 5: Accessories combo -->
      <div class="col-md-6 col-lg-4">
        <div
          class="card border-0 shadow-sm rounded-4 overflow-hidden offer-card h-100 position-relative"
        >
          <div class="offer-badge" style="background: #0d6efd">Free Gear</div>
          <img
            src="https://placehold.co/600x400/f8f9fa/e60012?text=Riding+Gear"
            class="offer-img w-100"
            alt="Riding Gear"
          />
          <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h5 class="fw-bold mb-0">Premium Riding Gear</h5>
              <span class="badge bg-light-primary text-primary rounded-pill"
                >Worth ₹3,500</span
              >
            </div>
            <p class="text-muted small">
              Free helmet + gloves on purchase of any 160cc+ model
            </p>
            <div class="d-flex justify-content-between align-items-center mt-3">
              <div class="countdown">
                <i class="bi bi-gift me-1"></i> Limited stock
              </div>
              <a href="#" class="btn btn-sm btn-danger rounded-pill px-3"
                >Avail</a
              >
            </div>
          </div>
        </div>
      </div>
      <!-- Offer 6: Service package -->
      <div class="col-md-6 col-lg-4">
        <div
          class="card border-0 shadow-sm rounded-4 overflow-hidden offer-card h-100 position-relative"
        >
          <div class="offer-badge" style="background: #6c757d">
            Service Saver
          </div>
          <img
            src="https://placehold.co/600x400/f8f9fa/e60012?text=Service+Package"
            class="offer-img w-100"
            alt="Service Package"
          />
          <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h5 class="fw-bold mb-0">3-Year Service Plan</h5>
              <span class="badge bg-light-secondary text-secondary rounded-pill"
                >Save 25%</span
              >
            </div>
            <p class="text-muted small">
              Prepaid maintenance package at 25% discount on labour
            </p>
            <div class="d-flex justify-content-between align-items-center mt-3">
              <div class="countdown">
                <i class="bi bi-calendar-week me-1"></i> Offer ends Apr 30
              </div>
              <a href="#" class="btn btn-sm btn-danger rounded-pill px-3"
                >Enroll</a
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Finance & Exchange Banner -->
  <div class="row g-4 mb-5">
    <div class="col-md-6">
      <div
        class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-light-red bg-opacity-10"
      >
        <div class="d-flex align-items-center mb-3">
          <div
            class="stats-icon bg-light-danger text-danger me-3"
            style="background: rgba(230, 0, 18, 0.2)"
          >
            <i class="bi bi-currency-rupee fs-4"></i>
          </div>
          <h5 class="fw-bold mb-0">Easy Finance Options</h5>
        </div>
        <p class="text-muted">
          Get attractive interest rates starting from 7.99%* with minimal
          documentation. Pre-approved loans for existing customers.
        </p>
        <ul class="list-unstyled small">
          <li>
            <i class="bi bi-check-circle-fill text-danger me-2"></i> 100%
            on-road funding
          </li>
          <li>
            <i class="bi bi-check-circle-fill text-danger me-2"></i>
            Flexible tenure up to 48 months
          </li>
          <li>
            <i class="bi bi-check-circle-fill text-danger me-2"></i> Instant
            approval at dealership
          </li>
        </ul>
        <a
          href="#"
          class="btn btn-outline-danger mt-2 align-self-start rounded-pill px-4"
          >Check Eligibility</a
        >
      </div>
    </div>
    <div class="col-md-6">
      <div
        class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-light-success bg-opacity-10"
      >
        <div class="d-flex align-items-center mb-3">
          <div class="stats-icon bg-light-success text-success me-3">
            <i class="bi bi-arrow-left-right fs-4"></i>
          </div>
          <h5 class="fw-bold mb-0">Exchange Bonus</h5>
        </div>
        <p class="text-muted">
          Upgrade to a new Honda and get assured buyback value for your old
          vehicle. Plus extra ₹5,000 exchange bonus on select models.
        </p>
        <div class="mt-2">
          <div class="d-flex justify-content-between small fw-semibold">
            <span>Scooter exchange</span>
            <span>Up to ₹8,000</span>
          </div>
          <div class="d-flex justify-content-between small fw-semibold mt-1">
            <span>Motorcycle exchange</span>
            <span>Up to ₹12,000</span>
          </div>
        </div>
        <a
          href="#"
          class="btn btn-outline-danger mt-3 align-self-start rounded-pill px-4"
          >Get Valuation</a
        >
      </div>
    </div>
  </div>

  <!-- Newsletter / Test ride CTA -->
  <div
    class="card border-0 shadow-sm rounded-4 overflow-hidden text-center p-5"
    style="background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%)"
  >
    <h3 class="fw-bold text-white">Don't miss out on upcoming offers!</h3>
    <p class="text-white-50 mb-4">
      Subscribe to get exclusive deals, test ride invites, and festive discounts
      directly to your inbox.
    </p>
    <div class="row justify-content-center">
      <div class="col-md-6">
        <div class="input-group">
          <input
            type="email"
            class="form-control rounded-start-pill ps-4"
            placeholder="Your email address"
          />
          <button class="btn btn-danger rounded-end-pill px-4 fw-semibold">
            Subscribe <i class="bi bi-envelope-paper ms-1"></i>
          </button>
        </div>
        <p class="text-white-50 small mt-2">
          We respect your privacy. No spam.
        </p>
      </div>
    </div>
  </div>
</div>

<style>
  /* Custom color utilities (consistent with dashboard) */
  .bg-light-red {
    background-color: rgba(230, 0, 18, 0.1);
  }
  .bg-light-success {
    background-color: rgba(25, 135, 84, 0.1);
  }
  .bg-light-warning {
    background-color: rgba(255, 193, 7, 0.1);
  }
  .bg-light-primary {
    background-color: rgba(13, 110, 253, 0.1);
  }
  .bg-light-secondary {
    background-color: rgba(108, 117, 125, 0.1);
  }

  .stats-icon {
    width: 54px;
    height: 54px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    transition: all 0.2s ease;
  }

  .offer-card,
  .stats-card {
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .offer-card:hover,
  .stats-card:hover {
    transform: translateY(-5px);
  }

  .badge-soft-red {
    background-color: rgba(230, 0, 18, 0.12);
    color: #e60012;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 40px;
    font-size: 0.8rem;
  }

  .hero-section {
    background: linear-gradient(135deg, #ffffff 0%, #fef2f2 100%);
    border-radius: 28px;
    border: 1px solid #e600133e;
  }

  .section-title {
    position: relative;
    display: inline-block;
  }

  .offer-badge {
    position: absolute;
    top: 20px;
    right: 20px;
    background: #e60012;
    color: white;
    padding: 6px 14px;
    border-radius: 40px;
    font-weight: 600;
    font-size: 0.75rem;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    z-index: 2;
  }

  .offer-img {
    height: 200px;
    object-fit: cover;
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
  }

  .countdown {
    font-weight: 700;
    background: #f1f3f5;
    display: inline-block;
    padding: 4px 12px;
    border-radius: 40px;
    font-size: 0.85rem;
  }
</style>

<script></script>

<%- include("../partials/footer") %>
