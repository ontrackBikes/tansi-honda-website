<%- include("../partials/header") %>

<section class="insurance-hero text-center py-5 bg-light">
  <div class="container">
    <h1 class="fw-bold">About Tansi Honda</h1>
    <p>
      Your trusted partner for Honda excellence
      <span class="text-danger">since 2010</span>
    </p>
  </div>
</section>

<!-- ========== HERO / HEADER AREA (matches dashboard style) ========== -->
<div class="container py-4">
  <!-- Hero / story section with image and tagline -->
  <div class="hero-section p-4 p-lg-5 mb-5 shadow-sm rounded-4">
    <div class="row align-items-center g-4">
      <div class="col-md-7">
        <h2 class="fw-bold mb-3">
          Riding the future,<br />
          rooted in trust
        </h2>
        <p class="text-muted lead fs-6">
          Tansi Honda is not just a dealership — we are a community of
          passionate riders, mechanics, and Honda enthusiasts. From the first
          test ride to lifetime service, we deliver the true spirit of Honda
          engineering.
        </p>
        <div class="d-flex flex-wrap gap-3 mt-4">
          <div>
            <i class="bi bi-check-circle-fill text-danger me-1"></i>
            <span class="fw-semibold">Authorized Honda Dealer</span>
          </div>
          <div>
            <i class="bi bi-check-circle-fill text-danger me-1"></i>
            <span class="fw-semibold">10+ Years of Excellence</span>
          </div>
          <div>
            <i class="bi bi-check-circle-fill text-danger me-1"></i>
            <span class="fw-semibold">20,000+ Happy Riders</span>
          </div>
        </div>
      </div>
      <div class="col-md-5 text-center">
        <div class="bg-light-red rounded-4 p-3 d-inline-block shadow-sm">
          <i class="bi bi-shop fs-1 text-danger"></i>
          <h3 class="fw-bold mb-0 mt-2">#HondaFamily</h3>
          <p class="small text-muted mb-0">Tamil Nadu's most trusted hub</p>
        </div>
      </div>
    </div>
  </div>

  <!-- STATS CARDS (like admin dashboard metrics) -->
  <div class="row g-4 mb-5">
    <div class="col-md-3 col-sm-6">
      <div class="card border-0 shadow-sm rounded-4 p-3 stats-card h-100">
        <div class="d-flex align-items-center">
          <div class="stats-icon bg-light-red text-danger me-3">
            <i class="bi bi-calendar2-check fs-4"></i>
          </div>
          <div>
            <p class="text-muted small mb-0 fw-semibold">Years of Legacy</p>
            <h3 class="fw-bold mb-0">14+</h3>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="card border-0 shadow-sm rounded-4 p-3 stats-card h-100">
        <div class="d-flex align-items-center">
          <div class="stats-icon bg-light-success text-success me-3">
            <i class="bi bi-people fs-4"></i>
          </div>
          <div>
            <p class="text-muted small mb-0 fw-semibold">Happy Customers</p>
            <h3 class="fw-bold mb-0">20k+</h3>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="card border-0 shadow-sm rounded-4 p-3 stats-card h-100">
        <div class="d-flex align-items-center">
          <div class="stats-icon bg-light-warning text-warning me-3">
            <i class="bi bi-trophy fs-4"></i>
          </div>
          <div>
            <p class="text-muted small mb-0 fw-semibold">Awards Won</p>
            <h3 class="fw-bold mb-0">12</h3>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-3 col-sm-6">
      <div class="card border-0 shadow-sm rounded-4 p-3 stats-card h-100">
        <div class="d-flex align-items-center">
          <div class="stats-icon bg-light-primary text-primary me-3">
            <i class="bi bi-geo-alt fs-4"></i>
          </div>
          <div>
            <p class="text-muted small mb-0 fw-semibold">Service Centers</p>
            <h3 class="fw-bold mb-0">3</h3>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- MISSION & VISION row (cards style) -->
  <div class="row g-4 mb-5">
    <div class="col-md-6">
      <div class="card border-0 shadow-sm rounded-4 p-4 info-card h-100">
        <div
          class="stats-icon bg-light-red mb-3"
          style="width: 48px; height: 48px"
        >
          <i class="bi bi-bullseye fs-5 text-danger"></i>
        </div>
        <h4 class="fw-bold">Our Mission</h4>
        <p class="text-muted">
          To empower every rider with world-class Honda motorcycles and
          unmatched service, creating lifelong relationships through
          transparency, innovation, and passion for two wheels.
        </p>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card border-0 shadow-sm rounded-4 p-4 info-card h-100">
        <div
          class="stats-icon bg-light-success mb-3"
          style="width: 48px; height: 48px"
        >
          <i class="bi bi-eye fs-5 text-success"></i>
        </div>
        <h4 class="fw-bold">Our Vision</h4>
        <p class="text-muted">
          To be the most admired Honda partner in South India, setting
          benchmarks in customer delight, digital convenience, and sustainable
          mobility solutions.
        </p>
      </div>
    </div>
  </div>

  <!-- JOURNEY TIMELINE / MILESTONES -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
    <div class="card-header bg-white border-0 p-4 pb-0">
      <h5 class="fw-bold mb-0">
        <i class="bi bi-clock-history me-2 text-danger"></i> The Tansi Honda
        Journey
      </h5>
      <p class="text-muted small mt-1">Milestones that shaped our story</p>
    </div>
    <div class="card-body p-4 pt-2">
      <div class="row g-4">
        <div class="col-md-3 col-sm-6">
          <div class="d-flex">
            <div class="me-3"><span class="timeline-dot"></span></div>
            <div>
              <h6 class="fw-bold mb-0">2010</h6>
              <p class="small text-muted">
                Foundation & first showroom in Chennai
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-3 col-sm-6">
          <div class="d-flex">
            <div class="me-3"><span class="timeline-dot"></span></div>
            <div>
              <h6 class="fw-bold mb-0">2015</h6>
              <p class="small text-muted">
                Expanded service network to 2 cities
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-3 col-sm-6">
          <div class="d-flex">
            <div class="me-3"><span class="timeline-dot"></span></div>
            <div>
              <h6 class="fw-bold mb-0">2020</h6>
              <p class="small text-muted">
                Digital showroom & contactless service launch
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-3 col-sm-6">
          <div class="d-flex">
            <div class="me-3"><span class="timeline-dot"></span></div>
            <div>
              <h6 class="fw-bold mb-0">2024</h6>
              <p class="small text-muted">
                EV readiness & Honda certified pre-owned hub
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- MEET THE TEAM (leadership) -->
  <div class="mb-5">
    <div
      class="d-flex align-items-center justify-content-between align-items-end mb-4 flex-wrap"
    >
      <h3 class="fw-bold section-title">Leadership & Experts</h3>

      <a href="#" class="text-danger text-decoration-none small fw-semibold"
        >View all <i class="bi bi-arrow-right"></i
      ></a>
    </div>
    <div class="row g-4">
      <div class="col-md-3 col-sm-6">
        <div
          class="card border-0 shadow-sm rounded-4 p-3 team-card text-center h-100"
        >
          <div class="d-flex justify-content-center mb-3">
            <img
              src="https://randomuser.me/api/portraits/men/32.jpg"
              class="team-img"
              alt="Founder"
            />
          </div>
          <h6 class="fw-bold mb-0">Arun Selvam</h6>
          <p class="text-muted small">Founder & Managing Director</p>
          <div class="d-flex justify-content-center gap-2 mt-2">
            <i class="bi bi-linkedin text-secondary"></i>
            <i class="bi bi-envelope text-secondary"></i>
          </div>
        </div>
      </div>
      <div class="col-md-3 col-sm-6">
        <div
          class="card border-0 shadow-sm rounded-4 p-3 team-card text-center h-100"
        >
          <div class="d-flex justify-content-center mb-3">
            <img
              src="https://randomuser.me/api/portraits/women/68.jpg"
              class="team-img"
              alt="Sales Head"
            />
          </div>
          <h6 class="fw-bold mb-0">Priya Rajan</h6>
          <p class="text-muted small">Head of Sales & Customer Experience</p>
          <div class="d-flex justify-content-center gap-2 mt-2">
            <i class="bi bi-linkedin text-secondary"></i>
            <i class="bi bi-envelope text-secondary"></i>
          </div>
        </div>
      </div>
      <div class="col-md-3 col-sm-6">
        <div
          class="card border-0 shadow-sm rounded-4 p-3 team-card text-center h-100"
        >
          <div class="d-flex justify-content-center mb-3">
            <img
              src="https://randomuser.me/api/portraits/men/45.jpg"
              class="team-img"
              alt="Service Manager"
            />
          </div>
          <h6 class="fw-bold mb-0">Karthik Murali</h6>
          <p class="text-muted small">Service Operations Manager</p>
          <div class="d-flex justify-content-center gap-2 mt-2">
            <i class="bi bi-linkedin text-secondary"></i>
            <i class="bi bi-envelope text-secondary"></i>
          </div>
        </div>
      </div>
      <div class="col-md-3 col-sm-6">
        <div
          class="card border-0 shadow-sm rounded-4 p-3 team-card text-center h-100"
        >
          <div class="d-flex justify-content-center mb-3">
            <img
              src="https://randomuser.me/api/portraits/women/22.jpg"
              class="team-img"
              alt="Marketing Lead"
            />
          </div>
          <h6 class="fw-bold mb-0">Divya Nair</h6>
          <p class="text-muted small">Marketing & Digital Lead</p>
          <div class="d-flex justify-content-center gap-2 mt-2">
            <i class="bi bi-linkedin text-secondary"></i>
            <i class="bi bi-envelope text-secondary"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- WHY CHOOSE US / FEATURES GRID (similar to dashboard table style but cards) -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5">
    <div class="card-header bg-white border-0 p-4 pb-0">
      <h5 class="fw-bold mb-0">
        <i class="bi bi-stars me-2 text-danger"></i> Why riders choose Tansi
        Honda
      </h5>
    </div>
    <div class="card-body p-4">
      <div class="row g-4">
        <div class="col-md-3 col-sm-6">
          <div class="d-flex align-items-start">
            <i class="bi bi-wrench text-danger fs-4 me-3"></i>
            <div>
              <h6 class="fw-bold">Expert Service</h6>
              <p class="small text-muted">
                Honda certified technicians with genuine spares
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-3 col-sm-6">
          <div class="d-flex align-items-start">
            <i class="bi bi-cash-stack text-danger fs-4 me-3"></i>
            <div>
              <h6 class="fw-bold">Flexible Finance</h6>
              <p class="small text-muted">
                Easy EMI & insurance assistance at best rates
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-3 col-sm-6">
          <div class="d-flex align-items-start">
            <i class="bi bi-truck text-danger fs-4 me-3"></i>
            <div>
              <h6 class="fw-bold">Free Test Ride</h6>
              <p class="small text-muted">
                Home test ride & doorstep delivery available
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-3 col-sm-6">
          <div class="d-flex align-items-start">
            <i class="bi bi-phone text-danger fs-4 me-3"></i>
            <div>
              <h6 class="fw-bold">Digital Connect</h6>
              <p class="small text-muted">
                Online booking, service reminders & live tracking
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Custom color utilities (matching the dashboard style) */
  .bg-light-red {
    background-color: rgba(230, 0, 18, 0.1);
  }
  .bg-light-success {
    background-color: rgba(25, 135, 84, 0.1);
  }
  .bg-light-warning {
    background-color: rgba(255, 193, 7, 0.1);
  }
  .bg-light-primary {
    background-color: rgba(13, 110, 253, 0.1);
  }
  .bg-light-secondary {
    background-color: rgba(108, 117, 125, 0.1);
  }
  .bg-light-dark {
    background-color: rgba(33, 37, 41, 0.08);
  }

  .stats-icon {
    width: 54px;
    height: 54px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    transition: all 0.2s ease;
  }

  .stats-card,
  .info-card,
  .team-card {
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .stats-card:hover,
  .info-card:hover,
  .team-card:hover {
    transform: translateY(-5px);
  }

  /* Brand red like Honda / admin dashboard */
  .btn-danger {
    background-color: #e60012;
    border: none;
    transition: 0.2s;
  }
  .btn-danger:hover {
    background-color: #c40010;
    transform: translateY(-2px);
  }
  .btn-outline-danger {
    border-color: #e60012;
    color: #e60012;
  }
  .btn-outline-danger:hover {
    background-color: #e60012;
    border-color: #e60012;
  }

  .badge-soft-red {
    background-color: rgba(230, 0, 18, 0.12);
    color: #e60012;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 40px;
    font-size: 0.8rem;
  }

  .hero-section {
    background: linear-gradient(135deg, #ffffff 0%, #fef2f2 100%);
    border-radius: 28px;
    border: 1px solid #e600133e;
  }

  .section-title {
    position: relative;
    display: inline-block;
  }

  .team-img {
    width: 120px;
    height: 120px;
    object-fit: cover;
    border-radius: 50%;
    border: 3px solid white;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
    transition: 0.2s;
  }

  .timeline-dot {
    width: 12px;
    height: 12px;
    background-color: #e60012;
    border-radius: 50%;
    display: inline-block;
    margin-right: 12px;
  }

  /* Responsive touches */
  @media (max-width: 768px) {
    .section-title:after {
      left: 50%;
      transform: translateX(-50%);
    }
  }
</style>

<script></script>

