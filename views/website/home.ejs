<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>
    Tansi Honda | Authorised Honda 2Wheeler Dealer Bangalore | Book Online
  </title>
  <meta name="description"
    content="Tansi Honda – Official Honda 2Wheeler dealer in Bangalore. Explore new bikes, scooters, EVs, book a test ride, grab special offers, and experience 'Click. Book. Relax.' service at your home." />
  <meta name="keywords"
    content="Honda bikes, Honda Activa, Honda CB350, Honda scooters, Tansi Honda, Honda EV, book Honda online, Bangalore Honda dealer" />
  <meta name="author" content="Tansi Honda" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://www.tansihonda.com/" />
  <!-- Open Graph -->
  <meta property="og:title" content="Tansi Honda - Click. Book. Relax. | Honda 2Wheelers" />
  <meta property="og:description"
    content="Book your favourite Honda two-wheeler from home. EMI options, exchange bonus, and doorstep delivery available." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://www.tansihonda.com/" />
  <meta property="og:locale" content="en_IN" />
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Tansi Honda - Click. Book. Relax." />
  <meta name="twitter:description" content="India's trusted Honda dealer. Book new bikes, scooters & EVs online." />
  <link rel="icon" type="image/x-icon" href="/images/fav/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,600;14..32,700;14..32,800&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background-color: #ffffff;
      color: #1e1e2f;
      line-height: 1.5;
      scroll-behavior: smooth;
    }

    .container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 20px;
    }

    /* Hero Section */
    .hero {
      background: linear-gradient(105deg, #fef9f5 0%, #fff 100%);
      padding: 50px 0 40px;
    }

    .hero-grid {
      display: flex;
      align-items: center;
      gap: 40px;
      flex-wrap: wrap;
    }

    .hero-content {
      flex: 1;
      min-width: 260px;
    }

    .hero-content h1 {
      font-size: clamp(2rem, 6vw, 3.4rem);
      font-weight: 800;
      line-height: 1.2;
      color: #1e1e2f;
    }

    .click-book {
      color: #e60012;
      letter-spacing: -0.5px;
    }

    .hero-tagline {
      font-size: clamp(1.1rem, 4vw, 1.4rem);
      margin: 20px 0 8px;
      font-weight: 600;
    }

    .hero-desc {
      color: #4a5568;
      font-size: 0.95rem;
      margin-bottom: 28px;
    }

    .btn-group {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
    }

    .button-custom {
      background: #e60012;
      border: 1px solid #e60012;
      padding: 10px 22px;
      border-radius: 50px;
      font-weight: 600;
      transition: 0.2s;
      text-decoration: none;
      color: #f4f4f8;
      display: inline-flex;
      align-items: center;
      gap: 12px;
      font-size: 0.9rem;
    }

    .button-custom:hover {
      border-color: #e60012;

      transform: translateY(-2px);
    }

    .outline-btn {
      background: #fff;
      border: 1px solid #121416;
      padding: 10px 22px;
      border-radius: 50px;
      font-weight: 600;
      transition: 0.2s;
      text-decoration: none;
      color: #1e1e2f;
      display: inline-flex;
      align-items: center;
      gap: 12px;
      font-size: 0.9rem;
    }

    .outline-btn:hover {
      border-color: #e60012;
      color: #e60012;
      transform: translateY(-2px);
    }

    .hero-image {
      flex: 1;
      text-align: center;
    }

    .hero-image img {
      max-width: 100%;
      height: auto;
      border-radius: 28px;
      box-shadow: 0 20px 35px -10px rgba(0, 0, 0, 0.2);
    }

    /* Section Title */
    .section-title {
      font-size: clamp(1.6rem, 5vw, 2rem);
      font-weight: 800;
      margin-bottom: 40px;
      text-align: center;
      position: relative;
    }

    .section-title:after {
      content: "";
      display: block;
      width: 70px;
      height: 4px;
      background: #e60012;
      margin: 12px auto 0;
      border-radius: 4px;
    }

    /* Model Cards - responsive grid */
    .model-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 30px;
      margin: 40px 0;
    }

    .model-card {
      background: white;
      border-radius: 24px;
      overflow: hidden;
      transition: all 0.3s ease;
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.05);
      border: 1px solid #f0f0f0;
    }

    .model-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 20px 35px rgba(0, 0, 0, 0.1);
    }

    .model-card img {
      width: 100%;
      height: 180px;
      object-fit: cover;
      background: #f9fafb;
    }

    .model-info {
      padding: 20px;
    }

    .model-info h3 {
      font-size: 1.3rem;
      font-weight: 700;
    }

    .model-info p {
      color: #4b5563;
      margin: 10px 0;
      font-size: 0.9rem;
    }

    .model-link {
      color: #e60012;
      font-weight: 600;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    /* Assistance Section */
    .assistance-section {
      background: #f8fafc;
      padding: 50px 20px;
      margin: 40px 0;
      border-radius: 40px;
    }

    .assist-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 25px;
      justify-content: center;
    }

    .assist-card {
      background: white;
      border-radius: 28px;
      padding: 24px 20px;
      text-align: center;
      flex: 1;
      min-width: 180px;
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.02);
      transition: 0.2s;
    }

    .assist-card i {
      font-size: 2.2rem;
      color: #e60012;
      margin-bottom: 12px;
    }

    /* Offers Banner */
    .offers-banner {
      background: linear-gradient(95deg, #1e1e2f, #2d2d44);
      color: white;
      border-radius: 32px;
      padding: 35px 25px;
      margin: 40px 0;
      text-align: center;
    }

    /* Brochure Buttons */
    .brochure-row {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 18px;
      margin: 40px 0;
    }

    .brochure-btn {
      background: #fff;
      border: 1px solid #e2e8f0;
      padding: 10px 22px;
      border-radius: 50px;
      font-weight: 600;
      transition: 0.2s;
      text-decoration: none;
      color: #1e1e2f;
      display: inline-flex;
      align-items: center;
      gap: 12px;
      font-size: 0.9rem;
    }

    .brochure-btn:hover {
      border-color: #e60012;
      color: #e60012;
      transform: translateY(-2px);
    }

    /* Contact Section */
    .contact-section {
      display: flex;
      flex-wrap: wrap;
      gap: 40px;
      margin: 60px 0;
      background: #ffffff;
    }

    .contact-info {
      flex: 1;
      min-width: 240px;
    }

    .contact-info h3 {
      font-size: 1.7rem;
      margin-bottom: 20px;
    }

    .contact-details p {
      margin: 16px 0;
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
    }

    .map-container {
      flex: 1;
      background: #eef2f6;
      border-radius: 28px;
      min-height: 240px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      /* IMPORTANT */
    }

    .map-placeholder {
      width: 100%;
      height: 100%;
    }

    .map-placeholder iframe {
      width: 100%;
      height: 100%;
      border: 0;
      display: block;
    }

    @media (max-width: 768px) {
      .container {
        padding: 0 16px;
      }

      .hero {
        padding: 40px 0 30px;
      }

      .hero-grid {
        flex-direction: column-reverse;
        text-align: center;
      }

      .btn-group {
        justify-content: center;
      }

      .assist-card {
        min-width: 160px;
      }

      .offers-banner {
        padding: 28px 18px;
      }

      .brochure-btn {
        padding: 8px 18px;
        font-size: 0.8rem;
      }

      .contact-section {
        flex-direction: column;
      }
    }

    @media (max-width: 480px) {
      .model-card img {
        height: 160px;
      }

      .btn {
        padding: 10px 22px;
        font-size: 0.85rem;
      }

      .hero-content h1 {
        font-size: 1.8rem;
      }

      .section-title {
        margin-bottom: 28px;
      }
    }
  </style>
</head>

<body>
  <%- include("../partials/header") %>

    <main>
      <!-- Hero Section -->
      <section class="hero">
        <div class="container hero-grid">
          <div class="hero-content">
            <h1>
              <span class="click-book">CLICK.</span>
              <span class="click-book">BOOK.</span>
              <span class="click-book">RELAX.</span>
            </h1>
            <div class="hero-tagline">Book your Honda 2 Wheelers</div>
            <p class="hero-desc">
              Experience Honda @ your Home. Doorstep test ride, EMI options, and
              exclusive online offers. <strong>Ride home in 24hrs*</strong>
            </p>
            <div class="btn-group">
              <a href="/motorcycle" class="button-custom" id="bookNowBtn"><i class="fas fa-calendar-check"></i> BOOK
                NOW</a>
              <a href="/quick-quote" class="outline-btn" id="quickQuoteHeroBtn"><i class="fas fa-comment-dots"></i>
                Quick Quote</a>
            </div>
          </div>
          <div class="hero-image">
            <img src="/images/homepage/tansi_honda.png" alt="Honda CB350 RS premium motorcycle" loading="eager"
              height="500" width="500" />
          </div>
        </div>
      </section>
      <!-- Featured Models -->
      <div class="container">
        <h2 class="section-title">Explore Our Lineup</h2>
        <div class="row g-4" id="modelsContainer">
          <% if (!models.length) { %>
            <div class="col-12 text-center py-5">
              <h5 class="text-muted">🚫 No models available</h5>
            </div>
            <% } else { %>
              <% models.forEach(model=> { %>

                <div class="col-6 col-md-4 col-lg-3">
                  <a href="/<%= model.category %>/<%= model.slug %>" class="text-decoration-none text-dark">

                    <div class="card h-100 border-0 shadow-sm rounded-4  hover-shadow">

                      <div class="p-3">
                        <img src="<%= model.coverImage || '/images/default-bike.jpg' %>" alt="<%= model.name %>"
                          class="img-fluid" style="height: 180px; object-fit: contain;">
                      </div>

                      <div class="card-body pt-0">
                        <h5 class="fw-bold text-black mb-2">
                          <%= model.name %>
                        </h5>

                        <p class="text-muted small text-capitalize mb-2" style="
                         display: -webkit-box;
                         -webkit-line-clamp: 2;
                         -webkit-box-orient: vertical;
                          overflow: hidden;
                        ">
                          <%= model.description %>
                        </p>

                        <span class="text-danger fw-semibold">
                          Explore <i class="fas fa-arrow-right ms-1"></i>
                        </span>
                      </div>

                    </div>

                  </a>
                </div>

                <% }) %>
                  <% } %>
        </div>

      </div>
      <!-- Assistance Section -->
      <div class="container">
        <div class="assistance-section">
          <h2 class="section-title">Tansi Honda Assistance</h2>
          <div class="assist-grid">
            <div class="assist-card">
              <i class="fas fa-headset"></i>
              <h5 class="fw-bold">24/7 Roadside</h5>
              <p>Emergency assistance anytime</p>
            </div>
            <div class="assist-card">
              <i class="fas fa-tachometer-alt"></i>
              <h5 class="fw-bold">Free Service Camp</h5>
              <p>Periodic checkup camps</p>
            </div>
            <div class="assist-card">
              <i class="fas fa-home"></i>
              <h5 class="fw-bold">Doorstep Service</h5>
              <p>Pick & drop at your home</p>
            </div>
            <div class="assist-card">
              <i class="fas fa-file-invoice-dollar"></i>
              <h5 class="fw-bold">Insurance & EMI</h5>
              <p>Easy finance, zero down payment*</p>
            </div>
          </div>
        </div>
      </div>
      <!-- Special Offers Banner -->
      <div class="container">
        <div class="offers-banner">
          <h4>
            <i class="fas fa-gift"></i> Special Offers – BigWing & RedWing
          </h4>
          <p>
            Up to ₹10,000 exchange bonus + Free helmet on select models. Limited
            period only.
          </p>
          <a href="/special-offer" class="button-custom" style="background: #fff; color: #e60012; margin-top: 12px">Grab
            Offer</a>
        </div>
      </div>
      <!-- Brochures -->
      <div class="container">
        <h2 class="section-title">Download Brochures</h2>
        <div class="brochure-row">
          <a href="#" class="brochure-btn"><i class="fas fa-file-pdf"></i> Red Wing Brochure</a>
          <a href="#" class="brochure-btn"><i class="fas fa-file-pdf"></i> BigWing Brochure</a>
          <a href="#" class="brochure-btn"><i class="fas fa-charging-station"></i> EV Brochure</a>
          <a href="#" class="brochure-btn"><i class="fas fa-motorcycle"></i> Scooters Catalogue</a>
        </div>
      </div>
      <!-- Contact & Map -->
      <div class="container">
        <div class="contact-section">
          <div class="contact-info">
            <h3 class="fw-bold">📍 Reach Us</h3>
            <p>
              <strong>Tansi Honda (Authorised Dealer)</strong><br />#45,
              Bannerghatta Main Road,<br />Bengaluru – 560029, Karnataka
            </p>
            <div class="contact-details">
              <p>
                <i class="fas fa-phone-alt" style="color: #e60012"></i> Sales:
                7259030091
              </p>
              <p><i class="fas fa-wrench"></i> Service: 7259586972</p>
              <p><i class="fas fa-tty"></i> Toll Free: 1800 532 9444</p>
              <p><i class="fas fa-envelope"></i> care@tansihonda.com</p>
            </div>
            <div class="btn-group mt-4">
              <a href="#" class="outline-btn"><i class="fas fa-directions"></i> Get Directions</a>
              <a href="#" class="button-custom"><i class="fas fa-calendar-alt"></i> Schedule Test Ride</a>
            </div>
          </div>
          <div class="map-container">
            <div class="map-placeholder">
              <iframe src="https://www.google.com/maps/d/embed?mid=1TsG7QBzueBxvpfVj2cX-JsI-e5c7nXc&ehbc=2E312F"
                width="640" height="480"></iframe>
            </div>
          </div>
        </div>
      </div>
    </main>

    <%- include("../partials/footer.ejs") %>
</body>

</html>