<%- include("../partials/header") %>

<div class="container">
  <!-- BANNER -->
  <section class="banner-slider">
    <div class="slides-track">
      <a href="/book-service" class="slide">
        <img src="/images/homepage/1.png" alt="" />
      </a>

      <a href="/directions" class="slide">
        <img src="/images/homepage/2.png" alt="" />
      </a>

      <a href="/special-offer" class="slide">
        <img src="/images/homepage/3.png" alt="" />
      </a>
    </div>

    <div class="slider-dots"></div>
  </section>

  <!-- FORM -->
  <div class="card border-1 shadow-sm rounded-4 overflow-hidden h-100 mb-5">
    <div class="card-header bg-white border-1 p-4 pb-0">
      <h3 class="card-title fw-bold mb-1">Service Appointment</h3>

      <p class="text-muted small">
        Fill the form and our team will contact you shortly
      </p>
    </div>

    <div class="card-body p-4">
      <form id="serviceForm" action="/create-appointment" method="POST">
        <div class="row g-3">
          <!-- NAME -->
          <div class="col-md-6">
            <label for="name" class="form-label">
              Name <span class="text-danger">*</span>
            </label>

            <input
              id="name"
              type="text"
              name="name"
              class="form-control"
              placeholder="Your Name"
              required
              pattern="^[a-zA-Z\s]+$"
              title="Only letters and spaces allowed"
            />
          </div>

          <!-- EMAIL -->
          <div class="col-md-6">
            <label for="email" class="form-label">
              E-Mail <span class="text-danger">*</span>
            </label>

            <input
              type="email"
              class="form-control"
              id="email"
              name="email"
              placeholder="you@example.com"
              required
            />
          </div>

          <!-- MOBILE -->
          <div class="col-md-6">
            <label for="mobile" class="form-label">
              Mobile Number <span class="text-danger">*</span>
            </label>

            <input
              type="tel"
              class="form-control"
              id="mobile"
              name="mobile"
              placeholder="10-digit Mobile Number"
              pattern="[6-9]{1}[0-9]{9}"
              maxlength="10"
              required
            />
          </div>

          <!-- MODEL -->
          <div class="col-md-6">
            <label for="model" class="form-label">
              Vehicle Model <span class="text-danger">*</span>
            </label>

            <input
              type="text"
              class="form-control"
              id="model"
              name="model"
              placeholder="Type vehicle model"
              list="vehicleModels"
              autocomplete="off"
              required
            />

            <datalist id="vehicleModels">
              <!-- Scooters -->
              <option value="Activa"></option>
              <option value="Dio"></option>
              <option value="Aviator"></option>
              <option value="Grazia"></option>

              <!-- Commuter Motorcycles -->
              <option value="Shine"></option>
              <option value="SP125"></option>
              <option value="Unicorn"></option>
              <option value="Livo"></option>
              <option value="CD 110 Dream"></option>

              <!-- Performance / Sports -->
              <option value="Hornet"></option>
              <option value="X-Blade"></option>
              <option value="CB200X"></option>

              <!-- Premium / BigWing -->
              <option value="H'ness CB350"></option>
              <option value="CB350RS"></option>
              <option value="CB300R"></option>
              <option value="CB300F"></option>
              <option value="Africa Twin"></option>
              <option value="Goldwing"></option>
            </datalist>
          </div>

          <!-- PICKUP -->
          <div class="col-12">
            <div class="form-check">
              <input
                class="form-check-input"
                type="checkbox"
                id="pickupDrop"
                name="pickupDrop"
              />

              <label class="form-check-label fw-semibold" for="pickupDrop">
                Need Pickup & Drop
              </label>
            </div>
          </div>

          <!-- SERVICE CENTRE -->
          <div class="col-md-6" id="serviceCentreWrapper">
            <label for="serviceCentre" class="form-label">
              Preferred Service Centre Location
              <span class="text-danger">*</span>
            </label>

            <select
              class="form-select"
              id="serviceCentre"
              name="serviceCentre"
              required
            >
              <option value="" disabled selected>Select Location</option>

              <option value="Hoodi">Hoodi</option>
              <option value="Marathahalli">Marathahalli</option>
              <option value="Gunjur">Gunjur</option>
              <option value="Panathur">Panathur</option>
              <option value="Seegehalli">Seegehalli</option>
              <option value="HRBR Layout">HRBR Layout</option>
              <option value="Ramagondanahalli">Ramagondanahalli</option>
            </select>
          </div>

          <!-- ADDRESS -->
          <div class="col-md-6 d-none" id="addressWrapper">
            <label for="address" class="form-label">
              Pickup Address <span class="text-danger">*</span>
            </label>

            <textarea
              class="form-control"
              id="address"
              name="address"
              rows="2"
              placeholder="Enter pickup address"
            ></textarea>
          </div>

          <!-- DATE -->
          <div class="col-md-6">
            <label for="preferredDate" class="form-label">
              Preferred Date <span class="text-danger">*</span>
            </label>

            <input
              type="date"
              class="form-control"
              id="preferredDate"
              name="preferredDate"
              required
            />
          </div>

          <!-- SUBMIT -->
          <div class="col-12 text-end mt-4">
            <button type="submit" class="btn btn-danger btn-lg">
              Book Appointment
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

<style>
  body {
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
    background: #fff;
  }

  .banner-slider {
    width: 100%;
    overflow: hidden;
    position: relative;
    padding: 35px 20px;
    box-sizing: border-box;
  }

  .slides-track {
    display: flex;
    gap: 22px;
    transition: transform 1.2s cubic-bezier(0.77, 0, 0.175, 1);
    will-change: transform;
    align-items: center;
  }

  .slide {
    flex: 0 0 calc(50% - 11px);
    border-radius: 16px;
    overflow: hidden;
    display: block;
    position: relative;
    transform: scale(0.88);
    opacity: 0.55;
    filter: blur(0.5px);
    transition: all 1s cubic-bezier(0.77, 0, 0.175, 1);
    box-shadow:
      0 12px 35px rgba(0, 0, 0, 0.08),
      0 3px 10px rgba(0, 0, 0, 0.04);
    text-decoration: none;
  }

  .slide img {
    width: 100%;
    display: block;
    object-fit: cover;
    user-select: none;
    pointer-events: none;
  }

  .slide.centerActive {
    transform: scale(1);
    opacity: 1;
    filter: blur(0px);
    z-index: 5;
    box-shadow:
      0 25px 55px rgba(0, 0, 0, 0.15),
      0 8px 20px rgba(0, 0, 0, 0.08);
  }

  .slide.sideActive {
    transform: scale(0.94);
    opacity: 0.88;
    filter: blur(0px);
  }

  .slider-dots {
    margin-top: 35px;
    display: flex;
    justify-content: center;
    gap: 14px;
  }

  .dot {
    width: 13px;
    height: 13px;
    border-radius: 50px;
    background: rgba(0, 0, 0, 0.15);
    cursor: pointer;
    transition: all 0.45s ease;
  }

  .dot.activeDot {
    width: 45px;
    background: #d60000;
    box-shadow: 0 4px 15px rgba(214, 0, 0, 0.35);
  }

  @media (max-width: 768px) {
    .banner-slider {
      padding: 20px 10px 35px;
    }

    .slide {
      flex: 0 0 100%;
      transform: scale(0.93);
      opacity: 0.75;
      filter: none;
    }

    .slide.centerActive {
      transform: scale(1);
    }

    .slide.sideActive {
      transform: scale(0.96);
    }
  }
</style>

<script>
  // PREVENT SAME DAY BOOKING
  const tomorrow = new Date();
  tomorrow.setDate(tomorrow.getDate() + 1);

  const minDate = tomorrow.toISOString().split("T")[0];

  document.getElementById("preferredDate").setAttribute("min", minDate);

  // PICKUP & DROP
  const pickupCheckbox = document.getElementById("pickupDrop");

  const serviceCentreWrapper = document.getElementById("serviceCentreWrapper");

  const addressWrapper = document.getElementById("addressWrapper");

  const serviceCentre = document.getElementById("serviceCentre");

  const address = document.getElementById("address");

  pickupCheckbox.addEventListener("change", function () {
    if (this.checked) {
      serviceCentreWrapper.classList.add("d-none");

      addressWrapper.classList.remove("d-none");

      serviceCentre.removeAttribute("required");

      address.setAttribute("required", true);
    } else {
      serviceCentreWrapper.classList.remove("d-none");

      addressWrapper.classList.add("d-none");

      serviceCentre.setAttribute("required", true);

      address.removeAttribute("required");
    }
  });

  // SLIDER
  document.addEventListener("DOMContentLoaded", function () {
    const track = document.querySelector(".slides-track");

    let slides = Array.from(document.querySelectorAll(".slide"));

    const dotsContainer = document.querySelector(".slider-dots");

    let visible = window.innerWidth <= 768 ? 1 : 2;

    let current = 0;
    let auto;
    let startX = 0;
    let isHover = false;

    slides.slice(0, visible + 2).forEach((slide) => {
      track.appendChild(slide.cloneNode(true));
    });

    const originalCount = slides.length;

    for (let i = 0; i < originalCount; i++) {
      const dot = document.createElement("span");

      dot.classList.add("dot");

      if (i === 0) {
        dot.classList.add("activeDot");
      }

      dot.onclick = () => {
        current = i;

        move();

        restartAuto();
      };

      dotsContainer.appendChild(dot);
    }

    const dots = document.querySelectorAll(".dot");

    function updateClasses() {
      document.querySelectorAll(".slide").forEach((slide) => {
        slide.classList.remove("centerActive", "sideActive");
      });

      const all = document.querySelectorAll(".slide");

      if (visible === 2) {
        if (all[current]) {
          all[current].classList.add("sideActive");
        }

        if (all[current + 1]) {
          all[current + 1].classList.add("centerActive");
        }
      } else {
        if (all[current]) {
          all[current].classList.add("centerActive");
        }
      }
    }

    function updateDots() {
      dots.forEach((dot) => dot.classList.remove("activeDot"));

      let active = current % originalCount;

      if (dots[active]) {
        dots[active].classList.add("activeDot");
      }
    }

    function move() {
      const slideWidth = document.querySelector(".slide").offsetWidth + 22;

      track.style.transform = `translateX(-${current * slideWidth}px)`;

      updateClasses();

      updateDots();
    }

    function next() {
      current++;

      if (current > originalCount) {
        move();

        setTimeout(() => {
          track.style.transition = "none";

          current = 0;

          move();

          setTimeout(() => {
            track.style.transition =
              "transform 1.2s cubic-bezier(0.77, 0, 0.175, 1)";
          }, 50);
        }, 1200);
      } else {
        move();
      }
    }

    function prev() {
      if (current <= 0) {
        current = originalCount - 1;
      } else {
        current--;
      }

      move();
    }

    function startAuto() {
      auto = setInterval(() => {
        if (!isHover) {
          next();
        }
      }, 3000);
    }

    function restartAuto() {
      clearInterval(auto);

      startAuto();
    }

    track.addEventListener("mouseenter", () => (isHover = true));

    track.addEventListener("mouseleave", () => (isHover = false));

    track.addEventListener("touchstart", (e) => {
      startX = e.touches[0].clientX;
    });

    track.addEventListener("touchend", (e) => {
      let endX = e.changedTouches[0].clientX;

      if (startX - endX > 50) {
        next();

        restartAuto();
      } else if (endX - startX > 50) {
        prev();

        restartAuto();
      }
    });

    updateClasses();

    startAuto();
  });
</script>

<%- include("../partials/footer") %>
