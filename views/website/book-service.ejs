<%- include("../partials/header") %>

<section class="container">
  <div class="carousel-card shadow-sm">
    <div
      id="carouselExampleDark"
      class="carousel carousel-dark slide"
      data-bs-ride="carousel"
    >
      <div class="carousel-indicators">
        <button
          type="button"
          data-bs-target="#carouselExampleDark"
          data-bs-slide-to="0"
          class="active"
        ></button>
        <button
          type="button"
          data-bs-target="#carouselExampleDark"
          data-bs-slide-to="1"
        ></button>
        <button
          type="button"
          data-bs-target="#carouselExampleDark"
          data-bs-slide-to="2"
        ></button>
      </div>

      <div class="carousel-inner">
        <div class="carousel-item active">
          <img
            src="/images/homepage/service-banner-1.png"
            class="d-block w-100"
          />
          <div class="carousel-caption d-none d-md-block">
            <h5>First slide</h5>
          </div>
        </div>

        <div class="carousel-item">
          <img
            src="/images/homepage/service-banner-2.png"
            class="d-block w-100"
          />
          <div class="carousel-caption d-none d-md-block">
            <h5>Second slide</h5>
          </div>
        </div>

        <div class="carousel-item">
          <img
            src="/images/homepage/service-banner-3.png"
            class="d-block w-100"
          />
          <div class="carousel-caption d-none d-md-block">
            <h5>Third slide</h5>
          </div>
        </div>
      </div>

      <button
        class="carousel-control-prev"
        type="button"
        data-bs-target="#carouselExampleDark"
        data-bs-slide="prev"
      >
        <span class="carousel-control-prev-icon"></span>
      </button>

      <button
        class="carousel-control-next"
        type="button"
        data-bs-target="#carouselExampleDark"
        data-bs-slide="next"
      >
        <span class="carousel-control-next-icon"></span>
      </button>
    </div>
  </div>
</section>

<div
  class="container card h-100 border-1 shadow-sm hover-shadow rounded-4 overflow-hidden my-4"
>
  <h3 class="card-title fw-bold mb-1">Service Appointment</h3>
  <p class="text-muted mb-0">Fill the form and we’ll get back to you</p>

  <hr />

  <form id="serviceForm" action="/create-appointment" method="POST">
    <div class="row g-3">
      <!-- Name -->
      <div class="col-md-6">
        <label for="name" class="form-label"
          >Name<span class="text-danger">*</span></label
        >
        <input
          id="name"
          type="text"
          name="name"
          class="form-control"
          placeholder="Your Name"
          required
          pattern="^[a-zA-Z\s]+$"
          title="Only letters and spaces allowed"
        />
      </div>

      <!-- Email -->
      <div class="col-md-6">
        <label for="email" class="form-label"
          >E-Mail<span class="text-danger">*</span></label
        >
        <input
          type="email"
          class="form-control"
          id="email"
          name="email"
          placeholder="you@example.com"
          required
        />
      </div>

      <!-- Mobile -->
      <div class="col-md-6">
        <label for="mobile" class="form-label"
          >Mobile Number <span class="text-danger">*</span></label
        >
        <input
          type="tel"
          class="form-control"
          id="mobile"
          name="mobile"
          placeholder="10-digit Mobile Number"
          pattern="^\d{10}$"
          required
        />
      </div>

      <!-- Model to be serviced -->
      <div class="col-md-6">
        <label for="model" class="form-label"
          >Model to be serviced <span class="text-danger">*</span></label
        >
        <input
          type="text"
          class="form-control"
          id="model"
          name="model"
          placeholder="Model to be serviced"
          required
          pattern="^[a-zA-Z\s]+$"
          title="Only letters and spaces allowed"
        />
      </div>

      <!-- Service Centre Location -->
      <div class="col-md-6">
        <label for="serviceCentre" class="form-label"
          >Preferred Service Centre Location
          <span class="text-danger">*</span></label
        >
        <select
          class="form-select"
          id="serviceCentre"
          name="serviceCentre"
          required
        >
          <option value="">Select Location</option>
          <option value="Bangalore Central">Bangalore Central</option>
          <option value="Bangalore East">Bangalore East</option>
          <option value="Bangalore West">Bangalore West</option>
        </select>
      </div>

      <!-- Preferred Date -->
      <div class="col-md-6">
        <label for="preferredDate" class="form-label">Preferred Date </label>
        <input
          type="date"
          class="form-control"
          id="preferredDate"
          name="preferredDate"
        />
      </div>

      <!-- Submit -->
      <div class="col-12 text-end mt-3">
        <button type="submit" class="btn btn-danger btn-lg">
          Book Appointment
        </button>
      </div>
    </div>
  </form>
</div>

<style>
  .carousel-card {
    max-width: 100%; /* make it small */
    margin: 30px auto; /* center */
    border-radius: 20px; /* rounded corners */
    overflow: hidden; /* clip image edges */
  }

  .carousel-card img {
    height: 300px; /* control height */
    /* object-fit: cover; */
  }
</style>

<!-- SCRIPT -->
<script>
  const today = new Date().toISOString().split("T")[0];
  document.getElementById("preferredDate").setAttribute("min", today);
</script>

<%- include("../partials/footer") %>
