<%- include("../partials/header") %>

<section class="service-hero text-center py-5 bg-light">
  <div class="container">
    <h1>Service Appointment</h1>
    <p>Schedule a Service Appointment by filling this form. Our team member will contact you soon.</p>
  </div>
</section>

<div class="container my-5">
  <h4 class="mb-4">Customer Information <small class="text-danger">* indicates required fields</small></h4>

  <form id="serviceForm" action="/submit-service-request" method="POST">
    <div class="row g-3">

      <!-- Name -->
      <div class="col-md-6">
        <label for="name" class="form-label">Name <span class="text-danger">*</span></label>
        <input type="text" class="form-control" id="name" name="name" placeholder="Your Name" required pattern="^[a-zA-Z\s]+$" title="Only letters and spaces allowed">
      </div>

      <!-- Email -->
      <div class="col-md-6">
        <label for="email" class="form-label">E-Mail <span class="text-danger">*</span></label>
        <input type="email" class="form-control" id="email" name="email" placeholder="you@example.com" required>
      </div>

      <!-- Mobile -->
      <div class="col-md-6">
        <label for="mobile" class="form-label">Mobile Number <span class="text-danger">*</span></label>
        <input type="tel" class="form-control" id="mobile" name="mobile" placeholder="10-digit Mobile Number" pattern="^\d{10}$" required>
      </div>

      <!-- Model to be serviced -->
      <div class="col-md-6">
        <label for="model" class="form-label">Model to be serviced <span class="text-danger">*</span></label>
        <select class="form-select" id="model" name="model" required>
          <option value="">Select Model</option>
          <% models.forEach(model => { %>
            <option value="<%= model.name %>"><%= model.name %></option>
          <% }) %>
        </select>
      </div>

      <!-- Type of Service -->
      <div class="col-md-6">
        <label for="serviceType" class="form-label">Type of Service <span class="text-danger">*</span></label>
        <select class="form-select" id="serviceType" name="serviceType" required>
          <option value="">Select Service Type</option>
          <option value="Periodic Service">Periodic Service</option>
          <option value="Repair">Repair</option>
          <option value="General Checkup">General Checkup</option>
        </select>
      </div>

      <!-- Preferred Date -->
      <div class="col-md-6">
        <label for="preferredDate" class="form-label">Preferred Date <span class="text-danger">*</span></label>
        <input type="date" class="form-control" id="preferredDate" name="preferredDate" required>
      </div>

      <!-- Service Centre Location -->
      <div class="col-md-6">
        <label for="serviceCentre" class="form-label">Preferred Service Centre Location <span class="text-danger">*</span></label>
        <select class="form-select" id="serviceCentre" name="serviceCentre" required>
          <option value="">Select Location</option>
          <option value="Bangalore Central">Bangalore Central</option>
          <option value="Bangalore East">Bangalore East</option>
          <option value="Bangalore West">Bangalore West</option>
        </select>
      </div>

      <!-- Pick up & Drop -->
      <div class="col-md-6">
        <label for="pickupDrop" class="form-label">Do you need Pick up & Drop? <span class="text-danger">*</span></label>
        <select class="form-select" id="pickupDrop" name="pickupDrop" required>
          <option value="">Select</option>
          <option value="Yes">Yes</option>
          <option value="No">No</option>
        </select>
      </div>

      <!-- Customer location for pick up & drop -->
      <div class="col-md-6" id="pickupLocationDiv" style="display:none;">
        <label for="pickupLocation" class="form-label">Customer location for Pick up & Drop</label>
        <input type="text" class="form-control" id="pickupLocation" name="pickupLocation" placeholder="Enter address">
      </div>

      <!-- Remarks -->
      <div class="col-12">
        <label for="remarks" class="form-label">Remarks</label>
        <textarea class="form-control" id="remarks" name="remarks" rows="3" placeholder="Any additional details..."></textarea>
      </div>

      <!-- Submit -->
      <div class="col-12 text-center mt-3">
        <button type="submit" class="btn btn-danger btn-lg">Submit Request</button>
      </div>

    </div>
  </form>
</div>

<!-- SCRIPT -->
<script>
const pickupDrop = document.getElementById("pickupDrop");
const pickupLocationDiv = document.getElementById("pickupLocationDiv");

pickupDrop.addEventListener("change", () => {
  if (pickupDrop.value === "Yes") {
    pickupLocationDiv.style.display = "block";
    document.getElementById("pickupLocation").required = true;
  } else {
    pickupLocationDiv.style.display = "none";
    document.getElementById("pickupLocation").required = false;
  }
});
</script>

<%- include("../partials/footer") %>